---
// A menu or package photo, or a placeholder tile while the photo is still to come.
import { Icon } from 'astro-icon/components';
import Photo from './Photo.astro';
interface Props {
  image: string | null;
  sizes: string;
  class?: string;
  eager?: boolean;
}
const { image, sizes, class: cls = '', eager = false } = Astro.props;
---

{image ? (
  <Photo
    name={image}
    sizes={sizes}
    class:list={['object-cover', cls]}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : (
  <span
    class:list={['flex flex-col items-center justify-center gap-2 bg-surface-2 text-muted', cls]}
  >
    <Icon name="ph:bowl-food" class="size-10" aria-hidden="true" />
    <span class="text-xs">Photo to come</span>
  </span>
)}
