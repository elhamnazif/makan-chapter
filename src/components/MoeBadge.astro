---
// SMCCI Muslim-Owned Enterprise mark. The dark variant has a light registered mark, so the
// picture switches to it when the visitor's system is in dark mode. Only one file is fetched.
import { getImage } from 'astro:assets';
import dark from '../assets/brand/moe-badge-v2-dark.webp';
import light from '../assets/brand/moe-badge-v2.webp';
interface Props {
  /** Largest rendered width in CSS pixels; 1x and 2x copies are made at this size. */
  px: number;
  class?: string;
  /** On the first screen: load with the page, not when scrolled to. */
  eager?: boolean;
}
const { px, class: cls = '', eager = false } = Astro.props;
const alt = 'Muslim-Owned Enterprise, Singapore Malay Chamber of Commerce and Industry';
const [l, d] = await Promise.all(
  [light, dark].map((src) => getImage({ src, width: px, densities: [1, 2] })),
);
---

<picture class="block shrink-0" data-moe-badge>
  <source media="(prefers-color-scheme: dark)" srcset={d.srcSet.attribute} />
  <img
    src={l.src}
    srcset={l.srcSet.attribute}
    alt={alt}
    width={px}
    height={px}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    class={`${cls} aspect-square max-w-none object-contain`}
  />
</picture>
