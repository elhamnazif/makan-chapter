---
import Photo from './Photo.astro';
interface Props {
  title: string;
  intro?: string;
  image: string;
  compact?: boolean;
}
const { title, intro, image, compact = false } = Astro.props;
---

<section
  class:list={[
    'relative isolate flex items-end overflow-hidden bg-ink',
    compact ? 'min-h-56 md:min-h-64' : 'min-h-72 md:min-h-96',
  ]}
>
  <Photo
    name={image}
    sizes="100vw"
    widths={[640, 960, 1280, 1600]}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/75 via-black/45 to-black/10"></div>
  <div class="container-page py-10 md:py-16">
    <h1 class="text-4xl font-bold tracking-tight text-white md:text-5xl">{title}</h1>
    {intro && <p class="mt-3 max-w-[46ch] text-base text-white/90 md:text-lg">{intro}</p>}
  </div>
</section>
