---
import { Icon } from 'astro-icon/components';
import { business, url, menuPdfs } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-auto bg-footer text-footer-ink">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="grid size-12 place-items-center overflow-hidden rounded-full bg-white">
          <img src={url('brand/logo.png')} alt="" width="48" height="48" class="size-12" loading="lazy" />
        </span>
        <span class="text-lg font-bold">{business.name}</span>
      </div>
      <address class="mt-5 space-y-3 text-sm not-italic text-footer-muted">
        <p>{business.address[0]},<br />{business.address[1]}</p>
        <p><span class="font-semibold text-footer-ink">Phone:</span> <a href={business.phoneHref} class="hover:underline">{business.phoneDisplay}</a></p>
        <p><span class="font-semibold text-footer-ink">Email:</span> <a href={`mailto:${business.email}`} class="hover:underline">{business.email}</a></p>
      </address>
      <ul class="mt-5 flex gap-2">
        <li><a href={business.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="ph:instagram-logo" class="size-5" aria-hidden="true" /></a></li>
        <li><a href={business.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="ph:facebook-logo" class="size-5" aria-hidden="true" /></a></li>
        <li><a href={`mailto:${business.email}`} aria-label="Email" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="ph:envelope-simple" class="size-5" aria-hidden="true" /></a></li>
        <li><a href={business.mapsUrl} target="_blank" rel="noopener" aria-label="Location on Google Maps" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Icon name="ph:map-pin" class="size-5" aria-hidden="true" /></a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold">Site Map</h2>
      <ul class="mt-3 space-y-1 text-sm text-footer-muted">
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('')}>Home</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('our-story/')}>Our Story</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('catering/mini-buffet/')}>Mini Buffet</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('catering/buffet/')}>Buffet Catering</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('order/')}>Order Online</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('contact/')}>Contact</a></li>
        <li><a class="inline-flex min-h-9 items-center hover:text-footer-ink" href={url('cart/')}>Cart</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-semibold">Menus</h2>
      <ul class="mt-3 space-y-1 text-sm text-footer-muted">
        {menuPdfs.map((m) => (
          <li><a class="inline-flex min-h-9 items-center gap-1.5 hover:text-footer-ink" href={m.href} target="_blank" rel="noopener">{m.label}<Icon name="ph:file-pdf" class="size-4" aria-label="PDF" /></a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-page py-6 text-center text-sm text-footer-muted">© {year} Makan Chapter Pte Ltd. All rights reserved.</p>
  </div>
</footer>
