---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
import { nav, url, business } from '../data/site';

const path = Astro.url.pathname;
const home = url('');
const isActive = (item: { href: string; match?: Array<string> }) => {
  if (item.href === '') { return path === home; }
  const prefixes = item.match ?? [item.href];
  return prefixes.some((p) => path.startsWith(url(p)));
};
---
<header class="sticky top-0 z-30 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/85">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-3 rounded-control" aria-label={`${business.name} home`}>
      <span class="grid size-11 place-items-center overflow-hidden rounded-full bg-white ring-1 ring-line">
        <img src={url('brand/logo.png')} alt="" width="44" height="44" class="size-11" />
      </span>
      <span class="text-lg font-bold tracking-tight">{business.name}</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li class="relative">
            {item.children ? (
              <>
                <button
                  type="button"
                  class:list={['flex min-h-11 items-center gap-1 rounded-full px-4 text-sm font-medium transition-colors', isActive(item) ? 'bg-accent text-accent-ink' : 'hover:bg-surface-2']}
                  aria-expanded="false"
                  aria-controls="catering-menu"
                  data-dropdown-toggle
                >
                  {item.label}
                  <Icon name="ph:caret-down-bold" class="size-3.5" aria-hidden="true" />
                </button>
                <ul id="catering-menu" class="card absolute left-0 top-full z-40 mt-2 min-w-52 p-1.5" hidden data-dropdown>
                  {item.children.map((c) => (
                    <li>
                      <a href={url(c.href)} class="flex min-h-11 items-center rounded-control px-3 text-sm hover:bg-surface-2" aria-current={path.startsWith(url(c.href)) ? 'page' : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={url(item.href)}
                class:list={['flex min-h-11 items-center rounded-full px-4 text-sm font-medium transition-colors', isActive(item) ? 'bg-accent text-accent-ink' : 'hover:bg-surface-2']}
                aria-current={isActive(item) ? 'page' : undefined}
              >{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ThemeToggle />
      <a href={url('cart/')} class="relative grid size-11 place-items-center rounded-full hover:bg-surface-2" aria-label="Cart" data-cart-link>
        <Icon name="ph:shopping-cart-simple" class="size-6" aria-hidden="true" />
        <span class="absolute right-0.5 top-0.5 grid min-w-5 place-items-center rounded-full bg-accent px-1 text-[11px] font-bold leading-5 text-accent-ink" data-cart-count hidden>0</span>
      </a>
      <button type="button" class="grid size-11 place-items-center rounded-full hover:bg-surface-2 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-drawer-open>
        <Icon name="ph:list" class="size-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-nav" class="fixed inset-0 z-50 lg:hidden" hidden data-drawer>
  <div class="absolute inset-0 bg-[var(--mc-scrim)]" data-drawer-close></div>
  <nav aria-label="Mobile" class="absolute inset-y-0 right-0 flex w-[min(20rem,85vw)] flex-col bg-surface p-4 shadow-card">
    <div class="mb-4 flex items-center justify-between">
      <span class="font-bold">Menu</span>
      <button type="button" class="grid size-11 place-items-center rounded-full hover:bg-surface-2" aria-label="Close menu" data-drawer-close>
        <Icon name="ph:x" class="size-6" aria-hidden="true" />
      </button>
    </div>
    <ul class="flex flex-col gap-1">
      {nav.map((item) => (
        <li>
          {item.children ? (
            <>
              <span class="block px-3 pb-1 pt-3 text-xs font-semibold text-muted">{item.label}</span>
              <ul>
                {item.children.map((c) => (
                  <li><a href={url(c.href)} class="flex min-h-11 items-center rounded-control px-3 hover:bg-surface-2">{c.label}</a></li>
                ))}
              </ul>
            </>
          ) : (
            <a href={url(item.href)} class:list={['flex min-h-11 items-center rounded-control px-3', isActive(item) ? 'bg-accent text-accent-ink' : 'hover:bg-surface-2']}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>

<script>
  import { cartCount } from '../scripts/cart';

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  const cartLink = document.querySelector<HTMLElement>('[data-cart-link]');
  const syncCount = () => {
    const n = cartCount();
    if (!badge || !cartLink) { return; }
    badge.textContent = String(n);
    badge.hidden = n === 0;
    cartLink.setAttribute('aria-label', n ? `Cart, ${n} item${n > 1 ? 's' : ''}` : 'Cart');
  };
  syncCount();
  document.addEventListener('cart:change', syncCount);
  window.addEventListener('storage', syncCount);

  // Catering dropdown
  const toggle = document.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-dropdown]');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) { return; }
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };
  toggle?.addEventListener('click', () => setOpen(Boolean(menu?.hidden)));
  document.addEventListener('click', (e) => {
    if (toggle && menu && !toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) { setOpen(false); }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) { setOpen(false); toggle?.focus(); }
  });

  // Mobile drawer
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const opener = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const openDrawer = (open: boolean) => {
    if (!drawer || !opener) { return; }
    drawer.hidden = !open;
    opener.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) { drawer.querySelector<HTMLElement>('[data-drawer-close].grid')?.focus(); }
    else { opener.focus(); }
  };
  opener?.addEventListener('click', () => openDrawer(true));
  drawer?.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => openDrawer(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) { openDrawer(false); } });
</script>
