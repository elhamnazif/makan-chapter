---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { nav, url, business } from '../data/site';
import type { NavItem } from '../data/site';

const path = Astro.url.pathname;
const home = url('');
const isActive = (item: NavItem) =>
  item.href === ''
    ? path === home
    : (item.match ?? [item.href]).some((p) => path.startsWith(url(p)));
---

<header id="site-header" class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={home}
      class="flex items-center gap-3 rounded-control"
      aria-label={`${business.name} home`}
    >
      <span class="grid size-11 place-items-center overflow-hidden rounded-full bg-white ring-1 ring-line">
        <Image src={logo} alt="" width={44} densities={[1, 2]} loading="eager" class="size-11" />
      </span>
      <span class="display whitespace-nowrap text-lg sm:text-xl">{business.name}</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'flex min-h-11 items-center rounded-full px-4 text-sm font-medium transition-colors',
                isActive(item) ? 'bg-accent text-accent-ink' : 'hover:bg-surface-2',
              ]}
              aria-current={isActive(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Pulled out by the icon buttons' inner padding, so the last icon's ink (not its 44px
         hit area) ends on the trailing line. -->
    <div class="-mr-3 flex items-center gap-1">
      <a
        href={url('cart/')}
        class="relative grid size-11 place-items-center rounded-full hover:bg-surface-2"
        aria-label="Cart"
        data-cart-link
      >
        <Icon name="ph:shopping-cart-simple" class="size-6" aria-hidden="true" />
        <span
          class="absolute right-0.5 top-0.5 grid min-w-5 place-items-center rounded-full bg-accent px-1 text-[11px] font-bold leading-5 text-accent-ink"
          data-cart-count
          hidden
        >
          0
        </span>
      </a>
      <!-- Paints the count before the first frame (see cartPainter in Layout.astro). -->
      <script is:inline>
        globalThis.mcPaintCart?.();
      </script>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full hover:bg-surface-2 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-drawer-open
      >
        <Icon name="ph:list" class="size-6" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-nav" class="drawer" aria-labelledby="mobile-nav-title" data-drawer>
  <div class="drawer-scroller" data-drawer-scroller>
    <nav aria-label="Mobile" class="drawer-sheet bg-surface p-4 shadow-card" data-drawer-sheet>
      <!-- The title sits on the links' label line (the sheet's 16px plus their 12px). -->
      <div class="mb-4 flex items-center justify-between pl-3">
        <span id="mobile-nav-title" class="font-bold">
          Menu
        </span>
        <button
          type="button"
          class="grid size-11 place-items-center rounded-full hover:bg-surface-2"
          aria-label="Close menu"
          autofocus
          data-drawer-close
        >
          <Icon name="ph:x" class="size-6" aria-hidden="true" />
        </button>
      </div>
      <ul class="flex flex-col gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class:list={[
                'flex min-h-11 items-center rounded-control px-3',
                isActive(item) ? 'bg-accent text-accent-ink' : 'hover:bg-surface-2',
              ]}
              aria-current={isActive(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</dialog>

<script>
  import { find } from '../scripts/dom';

  // The cart numbers on the page (this badge, and the Order Online cart button and bar) are
  // first painted inline, before the first frame. Repaint them when the cart changes: on this
  // page, in another tab, or while this page was kept in the back/forward cache.
  const paintCart = () => window.mcPaintCart();
  document.addEventListener('cart:change', paintCart);
  window.addEventListener('storage', paintCart);
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      paintCart();
    }
  });
  // A page loaded in the background before the click (speculation rules in Layout.astro).
  document.addEventListener('prerenderingchange', paintCart);

  // Mobile drawer. Opening shows the modal dialog, then scrolls the sheet in; closing scrolls
  // it out, and the observer closes the dialog once the sheet has left, so a swipe, a tap on
  // the backdrop, the close button and Escape all end in the same place.
  const drawer = find<HTMLDialogElement>('[data-drawer]');
  const scroller = find('[data-drawer-scroller]', drawer);
  const sheet = find('[data-drawer-sheet]', drawer);
  const opener = find<HTMLButtonElement>('[data-drawer-open]');

  const openDrawer = () => {
    drawer.showModal();
    scroller.scrollTo({ left: scroller.scrollWidth, behavior: 'auto' });
  };
  const closeDrawer = () => scroller.scrollTo({ left: 0, behavior: 'auto' });

  const visibleThreshold = 1 / window.innerWidth;
  new IntersectionObserver(
    (entries) => {
      const entry = entries.at(-1);
      if (!entry) {
        return;
      }
      if (entry.intersectionRatio < visibleThreshold) {
        drawer.close();
        opener.setAttribute('aria-expanded', 'false');
      }
      if (entry.intersectionRatio === 1) {
        opener.setAttribute('aria-expanded', 'true');
      }
    },
    { root: drawer, threshold: [visibleThreshold, 1] },
  ).observe(sheet);

  opener.addEventListener('click', openDrawer);
  find('[data-drawer-close]', drawer).addEventListener('click', closeDrawer);
  // A tap on the dimmed area: the dialog fills the viewport, so taps land on it, not ::backdrop.
  drawer.addEventListener('click', (e) => {
    if (!sheet.contains(e.target as Node | null)) {
      closeDrawer();
    }
  });
  // Escape slides the sheet out instead of closing at once. Browsers may not let a repeated
  // Escape be cancelled, in which case the dialog simply closes.
  drawer.addEventListener('cancel', (e) => {
    if (e.cancelable) {
      e.preventDefault();
      closeDrawer();
    }
  });
  // The drawer is for narrow screens only.
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    if (e.matches) {
      drawer.close();
    }
  });
  // Without scroll-driven animations, drive the backdrop fade from the scroll position.
  if (!CSS.supports('animation-timeline: scroll()')) {
    scroller.addEventListener('scroll', () => {
      drawer.style.setProperty(
        '--drawer-backdrop',
        String(scroller.scrollLeft / sheet.offsetWidth),
      );
    });
  }
</script>
