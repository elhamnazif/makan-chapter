---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Malay catering in Singapore: mini buffets, buffet catering, nasi ambeng and kuih, delivered islandwide.',
} = Astro.props;
const fullTitle = title
  ? `${title} | Makan Chapter`
  : 'Makan Chapter | Malay Catering in Singapore';
const favicon = await getImage({ src: logo, width: 64, format: 'png' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon.src} type="image/png" />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only z-60 rounded-control bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <div role="region" aria-label="Notifications">
      <div
        id="toast"
        popover="manual"
        class="toast max-w-[90vw] rounded-full border-0 bg-accent p-0 text-accent-ink shadow-card"
      >
        <div class="flex items-center gap-1 py-1.5 pl-5 pr-1.5">
          <p class="text-sm font-medium" data-toast-text></p>
          <button
            type="button"
            popovertarget="toast"
            popovertargetaction="hide"
            class="grid size-9 shrink-0 place-items-center rounded-full hover:bg-black/10"
            aria-label="Dismiss"
          >
            <Icon name="ph:x-bold" class="size-4" aria-hidden="true" />
          </button>
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-toast-live></p>
    </div>
  </body>
</html>

<script>
  // Popover is not yet Baseline Widely available: load the polyfill only where it is missing.
  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
    void import('@oddbird/popover-polyfill');
  }
</script>
