---
import type { InferGetStaticPropsType } from 'astro';
import { Icon } from 'astro-icon/components';
import DemoBanner from '../../../components/DemoBanner.astro';
import MenuImage from '../../../components/MenuImage.astro';
import { eventMenus, eventPackages } from '../../../data/eventCatering';
import { url } from '../../../data/site';
import Layout from '../../../layouts/Layout.astro';
import { money } from '../../../lib/format';

export function getStaticPaths() {
  return eventMenus.map((menu) => ({ params: { menu: menu.slug }, props: { menu } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { menu } = Astro.props;
const orderHref = url(`catering/order/${menu.slug}/`);
---

<Layout title={`${menu.name} Menu`} description={menu.blurb}>
  <DemoBanner />
  <div class="container-page pb-16 pt-6">
    <a
      href={url('catering/')}
      class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      Back to Catering
    </a>

    <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_22rem]">
      <div>
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{menu.name}</h1>
        <p class="mt-2 text-lg text-muted">{menu.blurb}</p>
        <MenuImage
          image={menu.image}
          sizes="(min-width: 1200px) 780px, (min-width: 1024px) 60vw, 100vw"
          class="mt-6 aspect-[16/9] w-full rounded-card"
          eager
        />

        <h2 class="mt-10 text-2xl font-bold">The menu</h2>
        <p class="mt-1 text-muted">When you order, you choose one dish from each category.</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2" data-full-menu>
          {menu.categories.map((c) => (
            <section class="rounded-card border border-line bg-surface p-5" data-category={c.label}>
              <h3 class="text-lg font-bold text-price">{c.label}</h3>
              <p class="text-sm text-muted">
                {c.only ? `${eventPackages[c.only].name} only. Choose 1.` : 'Choose 1'}
              </p>
              <div class="mt-3 space-y-3 border-t border-line pt-3">
                {(c.sections ?? [{ label: '', options: c.options }]).map((s) => (
                  <div>
                    {s.label && (
                      <p class="mb-1.5 text-sm font-semibold uppercase tracking-wide text-muted">
                        {s.label}
                      </p>
                    )}
                    <ul class="space-y-2">
                      {s.options.map((o) => (
                        <li class="flex items-center gap-2">
                          <Icon
                            name="ph:dot-outline-fill"
                            class="size-4 shrink-0 text-muted"
                            aria-hidden="true"
                          />
                          {o}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <aside class="space-y-4 self-start lg:sticky lg:top-20" aria-label="Packages and prices">
        {Object.values(eventPackages).map((p) => (
          <div class="card p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-lg font-bold">{p.name}</h2>
              <p class="text-lg font-bold text-price">
                {money(menu.priceCents[p.key])}
                <span class="text-sm font-medium text-muted">/pax</span>
              </p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
            <p class="mt-2 text-sm">
              {p.deliveryLabel}: <strong>{money(p.deliveryCents)}</strong>
            </p>
          </div>
        ))}
        <a href={orderHref} class="btn btn-block" data-order>
          <Icon name="ph:arrow-right-bold" class="size-5" aria-hidden="true" />
          Order {menu.name}
        </a>
      </aside>
    </div>
  </div>
</Layout>
