---
import type { InferGetStaticPropsType } from 'astro';
import { Icon } from 'astro-icon/components';
import DemoBanner from '../../../components/DemoBanner.astro';
import MenuImage from '../../../components/MenuImage.astro';
import { eventMenus, eventPackages } from '../../../data/eventCatering';
import { url } from '../../../data/site';
import Layout from '../../../layouts/Layout.astro';
import { money } from '../../../lib/format';

export function getStaticPaths() {
  return eventMenus.map((menu) => ({ params: { menu: menu.slug }, props: { menu } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { menu } = Astro.props;
const orderHref = url(`catering/order/${menu.slug}/`);
---

<Layout title={`${menu.name} Menu`} description={menu.blurb}>
  <DemoBanner />
  <div class="container-page pb-14 pt-6 md:pb-20">
    <a
      href={url('catering/')}
      class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      Back to Catering
    </a>

    <!-- An 8/4 split: the menu, and one panel with both packages and the order button. Below
         1024px the panel sits between the photo and the menu, so the price comes first. -->
    <div class="cols mt-4">
      <div class="lg:col-span-8">
        <h1 class="display text-4xl text-price md:text-5xl">{menu.name}</h1>
        <p class="mt-3 text-lg text-muted">{menu.blurb}</p>
        <MenuImage
          image={menu.image}
          sizes="(min-width: 1200px) 747px, (min-width: 1024px) 62vw, 100vw"
          class="mt-6 aspect-[16/9] w-full rounded-card"
          eager
        />
      </div>

      <aside
        class="panel self-start lg:sticky lg:top-20 lg:col-span-4 lg:row-span-2"
        aria-label="Packages and prices"
      >
        {Object.values(eventPackages).map((p, i) => (
          <div class:list={[i > 0 && 'mt-5 border-t border-rule pt-5']}>
            <h2 class="display text-2xl">{p.name}</h2>
            <p class="mt-1 text-lg font-bold text-price">
              {money(menu.priceCents[p.key])}
              <span class="text-sm font-medium text-muted">/pax</span>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.description}</p>
            <p class="mt-2 text-sm">
              {p.deliveryLabel}: <strong>{money(p.deliveryCents)}</strong>
            </p>
          </div>
        ))}
        <a href={orderHref} class="btn btn-block mt-6" data-order>
          Order This Menu
          <Icon name="ph:arrow-right-bold" class="size-5" aria-hidden="true" />
        </a>
      </aside>

      <div class="lg:col-span-8">
        <h2 class="display text-3xl md:text-4xl lg:mt-2">The menu</h2>
        <p class="mt-2 text-muted">When you order, you choose one dish from each category.</p>
        <div class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-2" data-full-menu>
          {menu.categories.map((c) => (
            <section class="border-t border-rule pt-4" data-category={c.label}>
              <h3 class="display text-2xl text-price">{c.label}</h3>
              <p class="mt-1 text-sm text-muted">
                {c.only ? `${eventPackages[c.only].name} only. Choose 1.` : 'Choose 1'}
              </p>
              <div class="mt-4 space-y-4">
                {(c.sections ?? [{ label: '', options: c.options }]).map((s) => (
                  <div>
                    {s.label && (
                      <p class="mb-1.5 text-sm font-semibold uppercase tracking-wide text-muted">
                        {s.label}
                      </p>
                    )}
                    <ul class="space-y-1.5">
                      {s.options.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
