---
import type { InferGetStaticPropsType } from 'astro';
import { Icon } from 'astro-icon/components';
import DemoBanner from '../../../components/DemoBanner.astro';
import MenuImage from '../../../components/MenuImage.astro';
import RowTemplate from '../../../components/RowTemplate.astro';
import { eventMenus, eventPackages, fees } from '../../../data/eventCatering';
import { url, waLink } from '../../../data/site';
import Layout from '../../../layouts/Layout.astro';
import { emailPattern, phonePattern, postalPattern } from '../../../lib/fields';
import { money } from '../../../lib/format';

export function getStaticPaths() {
  return eventMenus.map((menu) => ({ params: { menu: menu.slug }, props: { menu } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { menu } = Astro.props;
const steps = ['Package', 'Menu', 'Event', 'Your details', 'Review and pay'];
const pkgs = Object.values(eventPackages);
---

<Layout title={`Order ${menu.name}`} description={`Order ${menu.name} catering for your event.`}>
  <DemoBanner />
  <div class="container-page pb-40 pt-6 lg:pb-16">
    <a
      href={url(`catering/menu/${menu.slug}/`)}
      class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      Back to {menu.name} menu
    </a>
    <h1 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl" data-title>
      Order {menu.name}
    </h1>

    <nav aria-label="Order steps" class="mt-6 scroll-mt-24" data-progress>
      <ol class="grid grid-cols-5 gap-1.5 sm:gap-3">
        {steps.map((s, i) => (
          <li>
            <button
              type="button"
              class="group flex w-full flex-col items-start gap-1.5 text-left disabled:cursor-default"
              data-goto={i + 1}
              disabled={i > 0}
            >
              <span class="h-1.5 w-full rounded-full bg-line group-data-[state=done]:bg-accent group-data-[state=current]:bg-accent"></span>
              <span class="text-xs font-medium text-muted group-data-[state=current]:font-bold group-data-[state=current]:text-ink">
                <span class="sm:hidden">{i + 1}</span>
                <span class="hidden sm:inline">
                  {i + 1}. {s}
                </span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_20rem]" data-layout>
      <form novalidate aria-label={`Order ${menu.name}`} data-menu={menu.slug} data-order>
        <!-- Step 1: package -->
        <section data-step="1" aria-labelledby="s1-title">
          <h2 id="s1-title" class="text-2xl font-bold" tabindex="-1">
            Choose a package
          </h2>
          <p class="mt-1 text-muted">Both packages use the same {menu.name} menu.</p>
          <fieldset class="mt-5" aria-describedby="package-error">
            <legend class="sr-only">Package</legend>
            <div class="grid gap-4 md:grid-cols-2">
              {pkgs.map((p) => (
                <label
                  class="card flex cursor-pointer flex-col overflow-hidden outline-accent has-[:checked]:border-accent has-[:checked]:outline-3 has-[:focus-visible]:outline-3"
                  data-package-card={p.key}
                >
                  <MenuImage
                    image={p.image}
                    sizes="(min-width: 1200px) 420px, (min-width: 768px) 45vw, 100vw"
                    class="aspect-[16/9] w-full"
                  />
                  <span class="flex flex-1 flex-col p-5">
                    <span class="flex items-start justify-between gap-3">
                      <span class="text-xl font-bold">{p.name}</span>
                      <input
                        type="radio"
                        name="package"
                        value={p.key}
                        class="mt-1.5 size-5 shrink-0"
                      />
                    </span>
                    <span class="mt-2 leading-relaxed text-muted">{p.description}</span>
                    <span class="mt-auto pt-4">
                      <span class="block text-lg font-bold text-price">
                        {money(menu.priceCents[p.key])}/pax
                      </span>
                      <span class="block text-sm text-muted">
                        {p.deliveryLabel} {money(p.deliveryCents)}
                      </span>
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
          <p id="package-error" class="field-error" hidden></p>
        </section>

        <!-- Step 2: dishes and pax -->
        <section data-step="2" aria-labelledby="s2-title" hidden>
          <h2 id="s2-title" class="text-2xl font-bold" tabindex="-1">
            Pick your menu
          </h2>
          <p class="mt-1 text-muted">Tick 1 dish in each category.</p>
          <div class="mt-5 grid gap-4">
            {menu.categories.map((c, ci) => (
              <fieldset
                class="rounded-card border border-line bg-surface p-5"
                data-category={c.label}
                data-only={c.only ?? ''}
                aria-describedby={`c${ci}-status`}
              >
                <legend class="float-left w-full">
                  <span class="block text-lg font-bold text-price">{c.label}</span>
                  <span id={`c${ci}-status`} class="block text-muted" data-status>
                    Choose 1 of {c.options.length}
                  </span>
                </legend>
                {(c.sections ?? [{ label: '', options: c.options }]).map((s) => (
                  <div class="clear-both pt-3">
                    {s.label && (
                      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-muted">
                        {s.label}
                      </p>
                    )}
                    <div class="grid gap-2 sm:grid-cols-2">
                      {s.options.map((o) => (
                        <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-control border border-line px-3 hover:bg-surface-2 has-[:checked]:border-accent has-[:checked]:bg-surface-2">
                          <input type="radio" name={`c${ci}`} value={o} class="size-5 shrink-0" />
                          <span>{o}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))}
                <p class="field-error" hidden data-cat-error></p>
              </fieldset>
            ))}
          </div>

          <div class="mt-6 rounded-card border border-line bg-surface p-5">
            <label for="pax" class="text-lg font-bold">
              Number of pax
            </label>
            <div class="mt-3 flex max-w-xs items-center gap-2">
              <button
                type="button"
                class="grid size-12 shrink-0 place-items-center rounded-control border border-line bg-surface hover:bg-surface-2"
                aria-label="Fewer pax"
                data-pax-step="-1"
              >
                <Icon name="ph:minus-bold" class="size-5" aria-hidden="true" />
              </button>
              <input
                id="pax"
                name="pax"
                type="number"
                inputmode="numeric"
                class="field text-center text-lg font-semibold"
                step="1"
                required
                aria-describedby="pax-help pax-error"
                data-invalid="Enter the number of pax as a whole number."
              />
              <button
                type="button"
                class="grid size-12 shrink-0 place-items-center rounded-control border border-line bg-surface hover:bg-surface-2"
                aria-label="More pax"
                data-pax-step="1"
              >
                <Icon name="ph:plus-bold" class="size-5" aria-hidden="true" />
              </button>
            </div>
            <p id="pax-help" class="field-help" data-pax-help></p>
            <p id="pax-error" class="field-error" hidden></p>
            <p class="mt-3 text-sm" data-only="classic" data-bulk>
              More than 100 pax?{' '}
              <a
                href={waLink(
                  `Hi Makan Chapter, I would like bulk terms for ${menu.name} catering for more than 100 pax.`,
                )}
                target="_blank"
                rel="noopener"
                class="font-semibold underline underline-offset-2"
              >
                WhatsApp us for bulk terms
              </a>
              .
            </p>
          </div>
        </section>

        <!-- Step 3: event details -->
        <section data-step="3" aria-labelledby="s3-title" hidden>
          <h2 id="s3-title" class="text-2xl font-bold" tabindex="-1">
            Event details
          </h2>
          <div class="mt-5 grid gap-5 rounded-card border border-line bg-surface p-5">
            <div>
              <label for="date" class="field-label">
                Event date
              </label>
              <input
                id="date"
                name="date"
                type="date"
                class="field max-w-xs"
                required
                aria-describedby="date-help date-error"
                data-missing="Choose your event date."
                data-invalid="Enter a valid date."
              />
              <p id="date-help" class="field-help" data-date-help></p>
              <p id="date-error" class="field-error" hidden></p>
            </div>
            <div data-only="mini">
              <label for="delivery-time" class="field-label">
                Delivery time
              </label>
              <input
                id="delivery-time"
                name="deliveryTime"
                type="time"
                class="field max-w-xs"
                required
                aria-describedby="delivery-time-help delivery-time-error"
                data-missing="Choose a delivery time."
              />
              <p id="delivery-time-help" class="field-help">
                We deliver at this time.
              </p>
              <p id="delivery-time-error" class="field-error" hidden></p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2" data-only="classic">
              <div>
                <label for="ready-time" class="field-label">
                  Time food should be ready
                </label>
                <input
                  id="ready-time"
                  name="readyTime"
                  type="time"
                  class="field"
                  required
                  aria-describedby="ready-time-help ready-time-error"
                  data-missing="Choose when the food should be ready."
                />
                <p id="ready-time-help" class="field-help">
                  Our team arrives 1 hour earlier to set up.
                </p>
                <p id="ready-time-error" class="field-error" hidden></p>
              </div>
              <div>
                <label for="teardown-time" class="field-label">
                  Teardown time
                </label>
                <input
                  id="teardown-time"
                  name="teardownTime"
                  type="time"
                  class="field"
                  required
                  aria-describedby="teardown-time-help teardown-time-error"
                  data-missing="Choose a teardown time."
                />
                <p id="teardown-time-help" class="field-help">
                  Teardown after 9pm adds {money(fees.lateTeardownCents)}.
                </p>
                <p id="teardown-time-error" class="field-error" hidden></p>
              </div>
            </div>
          </div>
        </section>

        <!-- Step 4: customer details -->
        <section data-step="4" aria-labelledby="s4-title" hidden>
          <h2 id="s4-title" class="text-2xl font-bold" tabindex="-1">
            Your details
          </h2>
          <div class="mt-5 grid gap-5 rounded-card border border-line bg-surface p-5 sm:grid-cols-2">
            <div>
              <label for="name" class="field-label">
                Full name
              </label>
              <input
                id="name"
                name="name"
                class="field"
                autocomplete="name"
                enterkeyhint="next"
                required
                aria-describedby="name-error"
                data-missing="Enter your name."
              />
              <p id="name-error" class="field-error" hidden></p>
            </div>
            <div>
              <label for="phone" class="field-label">
                Mobile number
              </label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="field"
                autocomplete="tel"
                inputmode="tel"
                enterkeyhint="next"
                placeholder="e.g. 9123 4567"
                required
                pattern={phonePattern}
                aria-describedby="phone-error"
                data-missing="Enter your mobile number."
                data-invalid="Enter a Singapore phone number, e.g. 9123 4567."
              />
              <p id="phone-error" class="field-error" hidden></p>
            </div>
            <div class="sm:col-span-2">
              <label for="email" class="field-label">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                class="field"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="none"
                spellcheck="false"
                enterkeyhint="next"
                placeholder="name@email.com"
                required
                pattern={emailPattern}
                aria-describedby="email-help email-error"
                data-missing="Enter your email address."
                data-invalid="Enter an email address, e.g. name@email.com."
              />
              <p id="email-help" class="field-help">
                Your receipt is sent here.
              </p>
              <p id="email-error" class="field-error" hidden></p>
            </div>
            <div>
              <label for="address" class="field-label">
                Delivery address
              </label>
              <input
                id="address"
                name="address"
                class="field"
                autocomplete="street-address"
                enterkeyhint="next"
                placeholder="Street, block and unit"
                required
                aria-describedby="address-error"
                data-missing="Enter the delivery address."
              />
              <p id="address-error" class="field-error" hidden></p>
            </div>
            <div>
              <label for="postal" class="field-label">
                Postal code
              </label>
              <input
                id="postal"
                name="postal"
                class="field"
                autocomplete="postal-code"
                inputmode="numeric"
                enterkeyhint="next"
                maxlength="6"
                placeholder="e.g. 328180"
                required
                pattern={postalPattern}
                aria-describedby="postal-help postal-error"
                data-missing="Enter your postal code."
                data-invalid="Enter a 6-digit postal code."
              />
              <p id="postal-help" class="field-help" data-postal-help>
                Delivery to the CBD or Sentosa adds {money(fees.cbdSentosaCents)}.
              </p>
              <p id="postal-error" class="field-error" hidden></p>
            </div>
            <div class="sm:col-span-2">
              <label for="remarks" class="field-label">
                Remarks or dietary notes <span class="font-normal text-muted">(optional)</span>
              </label>
              <textarea
                id="remarks"
                name="remarks"
                rows="3"
                class="field"
                placeholder="E.g. no spicy, no peanuts, access instructions"
              ></textarea>
            </div>
          </div>
        </section>

        <!-- Step 5: review and pay -->
        <section data-step="5" aria-labelledby="s5-title" hidden>
          <h2 id="s5-title" class="text-2xl font-bold" tabindex="-1">
            Review and pay
          </h2>
          <p class="mt-1 text-muted">Check your order. You can go back to change anything.</p>
          <div class="mt-5 grid gap-4 md:grid-cols-2" data-review></div>
          <div class="mt-4 rounded-card border-2 border-ink bg-surface p-5">
            <p class="font-bold">Order summary</p>
            <dl class="mt-3 space-y-2 text-sm" data-review-lines></dl>
          </div>
          <div class="mt-5">
            <label class="flex cursor-pointer items-start gap-3">
              <input
                type="checkbox"
                id="terms"
                name="terms"
                class="mt-0.5 size-5 shrink-0"
                required
                aria-describedby="terms-error"
                data-missing="Please agree to the Terms and Conditions to continue."
              />
              <span>
                I agree to the{' '}
                <a
                  href="#terms-text"
                  class="font-semibold underline underline-offset-2"
                  data-terms-link
                >
                  Terms and Conditions
                </a>
                .
              </span>
            </label>
            <p id="terms-error" class="field-error" hidden></p>
            <details id="terms-text" class="mt-3 rounded-card border border-line bg-surface p-4">
              <summary class="flex min-h-11 cursor-pointer items-center font-semibold">
                Terms and Conditions
              </summary>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-muted">
                <li>Full payment is taken when you place your order.</li>
                <li>Orders must be placed at least {fees.leadDays} days before the event.</li>
                <li>Cancellation and refund terms will be added here once confirmed.</li>
              </ul>
            </details>
            <p class="mt-4 text-sm text-muted">
              The full order total is charged immediately at checkout.
            </p>
          </div>
        </section>

        <!-- One set of controls: a sticky bar on phones, inline on desktop -->
        <div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur lg:static lg:mt-8 lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
          <div class="mx-auto flex max-w-xl items-center gap-3 lg:max-w-none">
            <div class="mr-auto lg:hidden">
              <p class="text-xs text-muted">Total</p>
              <p class="text-lg font-bold" data-total>
                S$0
              </p>
            </div>
            <button type="button" class="btn btn-outline" data-back hidden>
              <Icon name="ph:arrow-left-bold" class="size-4" aria-hidden="true" />
              Back
            </button>
            <button type="submit" class="btn lg:ml-auto" data-next>
              <span data-next-label>Next</span>
              <Icon name="ph:arrow-right-bold" class="size-4" aria-hidden="true" data-next-icon />
            </button>
          </div>
        </div>
      </form>

      <aside
        class="hidden self-start lg:sticky lg:top-20 lg:block"
        aria-label="Your order"
        data-summary
      >
        <div class="rounded-card border-2 border-ink bg-surface p-5" aria-live="polite">
          <p class="flex items-center gap-2 font-bold">
            <Icon name="ph:receipt" class="size-5" aria-hidden="true" />
            Your order
          </p>
          <dl class="mt-3 space-y-2 text-sm" data-summary-lines></dl>
        </div>
      </aside>
    </div>

    <!-- Confirmation (demo) -->
    <section class="mx-auto mt-4 max-w-2xl" aria-labelledby="done-title" hidden data-confirmation>
      <div class="card p-6 text-center md:p-10">
        <Icon name="ph:check-circle-fill" class="mx-auto size-16 text-accent" aria-hidden="true" />
        <h2 id="done-title" class="mt-4 text-3xl font-bold" tabindex="-1">
          Order confirmed
        </h2>
        <p class="mt-2 text-muted">
          Order <strong class="text-ink" data-ref></strong>. Thank you, <span data-done-name></span>
          !
        </p>
        <p class="mt-1 text-muted">
          A receipt has been sent to <strong class="text-ink" data-done-email></strong>.
        </p>
        <dl
          class="mt-6 space-y-2 rounded-card border border-line p-4 text-left text-sm"
          data-done-lines
        ></dl>
        <p class="note mt-6 text-left">
          Demo only: no payment was taken and no email was sent. On the live site, the payment page
          (for example PayNow or card) opens when you press Pay now.
        </p>
        <a href={url('catering/')} class="btn mt-6">
          Back to Catering
        </a>
      </div>
    </section>
  </div>

  <RowTemplate />
  <template id="tpl-total-row">
    <div class="flex items-baseline justify-between gap-4 border-t border-line pt-3">
      <dt class="font-bold" data-slot="label"></dt>
      <dd class="text-2xl font-bold" data-slot="value"></dd>
    </div>
  </template>
  <template id="tpl-review-card">
    <div class="rounded-card border border-line bg-surface p-4">
      <div class="flex items-center justify-between gap-3">
        <h3 class="font-bold" data-slot="title"></h3>
        <button
          type="button"
          class="min-h-11 px-2 text-sm font-semibold underline underline-offset-2"
          data-edit
        >
          Change
        </button>
      </div>
      <dl class="mt-1 space-y-1.5 text-sm" data-rows></dl>
    </div>
  </template>
  <template id="tpl-review-row">
    <div>
      <dt class="text-muted" data-slot="label"></dt>
      <dd class="font-medium" data-slot="value"></dd>
    </div>
  </template>
</Layout>

<script>
  import {
    eventPackages,
    fees,
    isCbdOrSentosa,
    menuBySlug,
    quote,
  } from '../../../data/eventCatering';
  import type { PackageKey } from '../../../data/eventCatering';
  import { daysFromToday, money, prettyDate, prettyTime } from '../../../lib/format';
  import { dataValue, fillRows, find, findAll, stamp } from '../../../scripts/dom';
  import { showMessage, validator } from '../../../scripts/validate';
  import type { Control } from '../../../scripts/validate';

  const form = find<HTMLFormElement>('[data-order]');
  const menu = menuBySlug(dataValue(form, 'menu'));
  const sections = findAll('[data-step]', form);
  const progress = findAll<HTMLButtonElement>('[data-goto]');
  const back = find<HTMLButtonElement>('[data-back]');
  const next = find<HTMLButtonElement>('[data-next]');
  const field = (id: string) => find<HTMLInputElement>(`#${id}`, form);
  const value = (id: string) => find<Control>(`#${id}`, form).value.trim();
  const pax = field('pax');
  const date = field('date');
  const deliveryTime = field('delivery-time');
  const readyTime = field('ready-time');
  const teardownTime = field('teardown-time');
  const postal = field('postal');
  const LAST = sections.length;
  let step = 1;
  let reached = 1;

  // Earliest bookable date: today plus the lead time, in calendar days.
  date.min = daysFromToday(fees.leadDays);
  date.dataset.under = `Please book at least ${fees.leadDays} days ahead. The earliest date is ${prettyDate(date.min)}.`;
  find('[data-date-help]').textContent =
    `Book at least ${fees.leadDays} days ahead. Earliest date: ${prettyDate(date.min)}.`;

  const check = validator(form, {
    'teardown-time': (el) =>
      readyTime.value && el.value <= readyTime.value
        ? 'Teardown must be after the food is ready.'
        : '',
  });

  const pkg = () => {
    const key = form.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value;
    return key === 'mini' || key === 'classic' ? eventPackages[key] : null;
  };
  const visibleCategories = () =>
    findAll<HTMLFieldSetElement>('[data-category]', form).filter((f) => !f.hidden);
  // The step's required controls, leaving out fields for the other package.
  const stepControls = (n: number) =>
    findAll<Control>('[required]', sections[n - 1]).filter(
      (c) => !c.closest('[data-only][hidden]'),
    );

  const paxMessages: Record<PackageKey, { under: string; over: string }> = {
    mini: {
      under: `${eventPackages.mini.name} starts from ${eventPackages.mini.minPax} pax.`,
      over: `${eventPackages.mini.name} is for up to ${eventPackages.mini.maxPax} pax. For more guests, choose ${eventPackages.classic.name}.`,
    },
    classic: {
      under: `${eventPackages.classic.name} starts from ${eventPackages.classic.minPax} pax. For fewer guests, choose ${eventPackages.mini.name}.`,
      over: `Online orders are for up to ${eventPackages.classic.maxPax} pax. For more, WhatsApp us for bulk terms.`,
    },
  };

  function groupError(el: HTMLElement, message: string) {
    el.textContent = message;
    el.hidden = !message;
  }

  // Package switch: show the matching dishes and event fields, keep pax inside the package's range.
  function applyPackage() {
    const p = pkg();
    findAll('[data-only]', form).forEach((el) => {
      el.hidden = Boolean(el.dataset.only && el.dataset.only !== p?.key);
    });
    if (!p) {
      return;
    }
    pax.min = String(p.minPax);
    if (p.maxPax) {
      pax.max = String(p.maxPax);
    } else {
      pax.removeAttribute('max');
    }
    const n = Number(pax.value);
    if (!pax.value || n < p.minPax) {
      pax.value = String(p.minPax);
    } else if (p.maxPax && n > p.maxPax) {
      pax.value = String(p.maxPax);
    }
    Object.assign(pax.dataset, { ...paxMessages[p.key], missing: paxMessages[p.key].under });
    find('[data-pax-help]').textContent = p.maxPax
      ? `${p.name}: ${p.minPax} to ${p.maxPax} pax.`
      : `${p.name}: minimum ${p.minPax} pax.`;
    showMessage(pax, '');
  }

  const currentQuote = () => {
    const p = pkg();
    return p
      ? quote(menu, p, {
          pax: Number(pax.value) || 0,
          postal: postal.value.trim(),
          teardownTime: teardownTime.value,
        })
      : null;
  };

  function fillLines(dl: HTMLElement, totalLabel: string) {
    const p = pkg();
    const q = currentQuote();
    const rows: Array<[string, string]> = [['Menu', menu.name]];
    if (p && q) {
      rows.push(
        ['Package', p.name],
        ...q.lines.map((l): [string, string] => [l.label, (l.extra ? '+' : '') + money(l.cents)]),
      );
    }
    fillRows(dl, rows);
    dl.append(stamp('tpl-total-row', { label: totalLabel, value: money(q?.totalCents ?? 0) }));
  }

  function render() {
    for (const f of visibleCategories()) {
      const picked = f.querySelector<HTMLInputElement>('input:checked');
      find('[data-status]', f).textContent = picked
        ? `Chosen: ${picked.value}`
        : `Choose 1 of ${f.querySelectorAll('input').length}`;
      if (picked) {
        groupError(find('[data-cat-error]', f), '');
      }
    }
    find('[data-postal-help]').textContent = isCbdOrSentosa(postal.value.trim())
      ? `CBD or Sentosa delivery: ${money(fees.cbdSentosaCents)} added to your total.`
      : `Delivery to the CBD or Sentosa adds ${money(fees.cbdSentosaCents)}.`;
    fillLines(find('[data-summary-lines]'), 'Total due now');
    find('[data-total]').textContent = money(currentQuote()?.totalCents ?? 0);
  }

  // Shows every message in a step and returns its first invalid control.
  function validate(n: number): HTMLElement | null {
    let first: HTMLElement | null = null;
    if (n === 1) {
      const missing = !pkg();
      groupError(
        find('#package-error'),
        missing ? 'Choose Mini Catering or Classic Catering.' : '',
      );
      if (missing) {
        first = find('input[name="package"]', form);
      }
    }
    if (n === 2) {
      for (const f of visibleCategories()) {
        const missing = !f.querySelector('input:checked');
        groupError(
          find('[data-cat-error]', f),
          missing ? `Choose 1 ${dataValue(f, 'category').toLowerCase()} dish.` : '',
        );
        if (missing) {
          first ??= find('input', f);
        }
      }
    }
    const badField = check(stepControls(n));
    return first ?? badField;
  }

  function reviewCard(title: string, rows: Array<[string, string]>, editStep: number) {
    const card = stamp('tpl-review-card', { title });
    const edit = find('[data-edit]', card);
    edit.setAttribute('aria-label', `Change ${title.toLowerCase()}`);
    edit.addEventListener('click', () => go(editStep));
    find('[data-rows]', card).append(
      ...rows.flatMap(([label, text]) =>
        text ? [stamp('tpl-review-row', { label, value: text })] : [],
      ),
    );
    return card;
  }

  function when(): string {
    const p = pkg();
    if (!date.value || !p) {
      return '';
    }
    return p.key === 'mini'
      ? `${prettyDate(date.value)}, delivery at ${prettyTime(deliveryTime.value)}`
      : `${prettyDate(date.value)}, food ready by ${prettyTime(readyTime.value)}, teardown at ${prettyTime(teardownTime.value)}`;
  }

  function renderReview() {
    const p = pkg();
    if (!p) {
      return;
    }
    const dishes = visibleCategories().map((f): [string, string] => [
      dataValue(f, 'category'),
      f.querySelector<HTMLInputElement>('input:checked')?.value ?? '',
    ]);
    find('[data-review]').replaceChildren(
      reviewCard(
        'Package and pax',
        [
          ['Menu', menu.name],
          ['Package', p.name],
          ['Pax', pax.value],
        ],
        1,
      ),
      reviewCard('Dishes', dishes, 2),
      reviewCard('Event', [['Date and time', when()]], 3),
      reviewCard(
        'Contact and delivery',
        [
          ['Name', value('name')],
          ['Mobile', value('phone')],
          ['Email', value('email')],
          ['Address', `${value('address')}, Singapore ${value('postal')}`],
          ['Remarks', value('remarks')],
        ],
        4,
      ),
    );
    fillLines(find('[data-review-lines]'), 'Total due now');
  }

  function go(n: number, initial = false) {
    step = n;
    reached = Math.max(reached, n);
    sections.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
    progress.forEach((b) => {
      const i = Number(b.dataset.goto);
      b.dataset.state = i === n ? 'current' : i <= reached ? 'done' : 'todo';
      b.disabled = i > reached;
      if (i === n) {
        b.setAttribute('aria-current', 'step');
      } else {
        b.removeAttribute('aria-current');
      }
    });
    back.hidden = n === 1;
    find('[data-next-label]').textContent = n === LAST ? 'Pay now: full payment' : 'Next';
    find('[data-next-icon]').classList.toggle('hidden', n === LAST);
    if (n === LAST) {
      renderReview();
    }
    render();
    if (initial) {
      return;
    }
    find('[data-progress]').scrollIntoView({ block: 'start', behavior: 'instant' });
    find('h2', sections[n - 1]).focus({ preventScroll: true });
  }

  function pay() {
    // Re-check every step before taking payment.
    for (let i = 1; i <= LAST; i++) {
      const bad = validate(i);
      if (bad) {
        if (i !== step) {
          go(i);
        }
        bad.focus();
        return;
      }
    }
    next.disabled = true;
    find('[data-next-label]').textContent = 'Processing payment...';
    window.setTimeout(() => {
      find('[data-ref]').textContent = `MC-${String(Date.now()).slice(-6)}`;
      find('[data-done-name]').textContent = field('name').value.trim().split(' ')[0];
      find('[data-done-email]').textContent = field('email').value.trim();
      const done = find('[data-done-lines]');
      fillLines(done, 'Amount paid');
      done.prepend(stamp('tpl-row', { label: 'When', value: when() }));
      find('[data-layout]').hidden = true;
      find('[data-progress]').hidden = true;
      find('[data-title]').textContent = `${menu.name}: order placed`;
      find('[data-confirmation]').hidden = false;
      window.scrollTo({ top: 0, behavior: 'instant' });
      find('#done-title').focus({ preventScroll: true });
    }, 1200);
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (step === LAST) {
      pay();
      return;
    }
    const bad = validate(step);
    if (bad) {
      bad.focus();
      return;
    }
    go(step + 1);
  });
  back.addEventListener('click', () => go(step - 1));
  progress.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));
  findAll<HTMLButtonElement>('[data-pax-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = pkg();
      if (!p) {
        return;
      }
      const v = (Number(pax.value) || p.minPax) + Number(b.dataset.paxStep);
      pax.value = String(Math.max(p.minPax, p.maxPax ? Math.min(p.maxPax, v) : v));
      showMessage(pax, '');
      render();
    }),
  );
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement | null)?.name === 'package') {
      applyPackage();
      groupError(find('#package-error'), '');
    }
    render();
  });
  form.addEventListener('input', render);
  find('[data-terms-link]').addEventListener('click', () => {
    find<HTMLDetailsElement>('#terms-text').open = true;
  });

  applyPackage();
  go(1, true);
</script>
