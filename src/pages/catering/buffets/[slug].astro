---
import type { InferGetStaticPropsType } from 'astro';
import { Icon } from 'astro-icon/components';
import Photo from '../../../components/Photo.astro';
import { buffets, priceLabel, quoteMessage } from '../../../data/buffets';
import { url, waLink } from '../../../data/site';
import Layout from '../../../layouts/Layout.astro';
import { money } from '../../../lib/format';

export function getStaticPaths() {
  return buffets.map((buffet) => ({ params: { slug: buffet.slug }, props: { buffet } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { buffet } = Astro.props;
---

<Layout title={`${buffet.name} Buffet`} description={buffet.blurb}>
  <div class="container-page pb-14 pt-6 md:pb-20">
    <a
      href={url('catering/#buffets')}
      class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      Back to Catering
    </a>

    <!-- An 8/4 split: the menu, and one panel with the price, terms and the quote button. Below
         1024px the panel sits between the photo and the menu, so the price comes first. -->
    <div class="cols mt-4">
      <div class="lg:col-span-8">
        <h1 class="display text-4xl text-price md:text-5xl">{buffet.name}</h1>
        <p class="mt-3 text-lg text-muted">{buffet.blurb}</p>
        <Photo
          name={buffet.image}
          sizes="(min-width: 1200px) 747px, (min-width: 1024px) 62vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="mt-6 aspect-[16/9] w-full rounded-card object-cover"
        />
      </div>

      <aside
        class="panel @container self-start lg:sticky lg:top-20 lg:col-span-4 lg:row-span-2"
        aria-label="Price and terms"
      >
        <p class="display text-3xl text-price">{priceLabel(buffet)}</p>
        <p class="mt-1 text-sm text-muted">Min. {buffet.minPax} pax</p>
        {buffet.promo && (
          <p class="mt-2 text-sm">
            {money(buffet.promo.perPaxCents)}/pax from {buffet.promo.fromPax} guests.
          </p>
        )}
        <p class="mt-5 flex gap-2 border-t border-rule pt-5 text-sm">
          <Icon name="ph:clock" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
          {buffet.notice}
        </p>
        <div class="grid gap-x-8 @[36rem]:grid-cols-2">
          <div class="mt-5 border-t border-rule pt-5">
            <h2 class="eyebrow">Included</h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {buffet.includes.map((i) => (
                <li class="flex gap-2">
                  <Icon name="ph:check" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
                  {i}
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-5 border-t border-rule pt-5">
            <h2 class="eyebrow">Terms</h2>
            <ul class="mt-3 space-y-1.5 text-sm text-muted">
              {buffet.terms.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        </div>
        <a
          href={waLink(quoteMessage(buffet))}
          target="_blank"
          rel="noopener"
          class="btn btn-block mt-6"
          data-quote
        >
          <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
          Get a Quotation on WhatsApp
        </a>
      </aside>

      <div class="lg:col-span-8">
        <h2 class="display text-3xl md:text-4xl lg:mt-2">The menu</h2>
        <div class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-2" data-full-menu>
          {buffet.groups.map((g) => (
            <section
              class:list={[
                'border-t border-rule pt-4',
                g.items.length > 6 && !g.choose && 'md:col-span-2',
              ]}
            >
              <h3 class="display text-2xl text-price">{g.label}</h3>
              <p class="mt-1 text-sm text-muted">
                {g.choose ? `Choose ${g.choose} of ${g.items.length}` : 'Included'}
              </p>
              <ul
                class:list={[
                  'mt-4 space-y-1.5',
                  g.items.length > 6 && !g.choose && 'gap-x-8 sm:columns-2',
                ]}
              >
                {g.items.map((item) => (
                  <li class="break-inside-avoid">{item}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
