---
import { Icon } from 'astro-icon/components';
import DemoBanner from '../../components/DemoBanner.astro';
import MenuImage from '../../components/MenuImage.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { buffets, occasions, priceLabel } from '../../data/buffets';
import { eventMenus, eventPackages, fromPriceCents } from '../../data/eventCatering';
import { url, waLink } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { money } from '../../lib/format';
---

<Layout
  title="Catering"
  description="Choose from five catering menus, then pick Mini or Classic catering for your event."
>
  <DemoBanner />
  <PageHero
    title="Catering"
    intro="Choose a menu, pick Mini or Classic catering, and book your event online."
    image="buffet-setup"
  />

  <!-- Menus: one row each. Photo on the text line (3 columns), name and price (5), actions
       ending on the trailing line (4). Every row is centred on one line. -->
  <section class="container-page section" aria-labelledby="menus-title">
    <p class="eyebrow">Mini and Classic Catering</p>
    <h2 id="menus-title" class="display mt-4 text-4xl text-price md:text-5xl">
      Our Catering Menus
    </h2>
    <p class="mt-5 max-w-[60ch] leading-relaxed text-muted">
      Every menu comes as Mini Catering (20 to 50 pax) or Classic Catering (from 50 pax). You choose
      one dish from each category.
    </p>

    <ul class="mt-10 border-t border-rule" data-menu-list>
      {eventMenus.map((m, i) => (
        <li
          class="grid grid-cols-[6.5rem_minmax(0,1fr)] items-center gap-x-4 gap-y-4 border-b border-rule py-6 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-x-8 lg:grid-cols-12"
          data-menu-card={m.slug}
        >
          <div class="lg:col-span-3">
            <MenuImage
              image={m.image}
              sizes="(min-width: 1200px) 260px, (min-width: 1024px) 22vw, (min-width: 640px) 192px, 104px"
              class="aspect-square w-full rounded-card sm:aspect-[4/3]"
              eager={i < 2}
            />
          </div>
          <div class="lg:col-span-5">
            <p class="eyebrow">Menu {String(i + 1).padStart(2, '0')}</p>
            <h3 class="display mt-2 text-2xl md:text-3xl">{m.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted md:text-base">{m.blurb}</p>
            <p class="mt-3 font-bold text-price md:text-lg">From {money(fromPriceCents(m))}/pax</p>
          </div>
          <div class="col-span-2 flex gap-3 lg:col-span-4 lg:justify-end">
            <a
              href={url(`catering/menu/${m.slug}/`)}
              class="btn btn-outline flex-1 lg:flex-none"
              data-view-menu
            >
              View Menu
            </a>
            <a href={url(`catering/order/${m.slug}/`)} class="btn flex-1 lg:flex-none" data-order>
              Order
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Packages: two ruled columns from 768px. Each is a subgrid of three rows (name,
       description, what is included), so the lists start on one line. -->
  <section class="section border-y border-rule bg-cream" aria-labelledby="packages-title">
    <div class="container-page">
      <p class="eyebrow">Two ways to serve</p>
      <h2 id="packages-title" class="display mt-4 text-4xl text-price md:text-5xl">
        Mini or Classic?
      </h2>
      <ul class="mt-10 grid gap-x-8 md:grid-cols-2">
        {Object.values(eventPackages).map((p) => (
          <li class="row-span-3 grid grid-rows-subgrid border-t border-rule pt-6 max-md:[&:not(:first-child)]:mt-10">
            <h3 class="display text-3xl">{p.name}</h3>
            <p class="pt-3 leading-relaxed text-muted">{p.description}</p>
            <ul class="space-y-2 pt-5">
              {p.includes.map((x) => (
                <li class="flex gap-2 text-sm">
                  <Icon name="ph:check" class="size-5 shrink-0 text-accent" aria-hidden="true" />
                  {x}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-sm text-muted">
        Book at least 3 days ahead. Full payment is taken when you order.
      </p>
    </div>
  </section>

  <!-- Buffets: three tiles side by side from 768px (never two and one), price rows on one line -->
  <section id="buffets" class="container-page section scroll-mt-16" aria-labelledby="buffets-title">
    <p class="eyebrow">By quotation</p>
    <h2 id="buffets-title" class="display mt-4 text-4xl text-price md:text-5xl">
      Buffets for Weddings and Large Events
    </h2>
    <p class="mt-5 max-w-[60ch] leading-relaxed text-muted">
      Full buffets with setup, staff and collection. Tell us your date and guest count on WhatsApp
      and we will send a quotation.
    </p>
    <!-- Each tile is a subgrid of five rows (photo, name, blurb, price, action). -->
    <ul class="mt-10 grid gap-x-6 md:grid-cols-3 lg:gap-x-8">
      {buffets.map((b) => (
        <li
          class="row-span-5 grid grid-rows-subgrid max-md:[&:not(:first-child)]:mt-12"
          data-buffet-card={b.slug}
        >
          <a
            href={url(`catering/buffets/${b.slug}/`)}
            class="group row-span-5 grid grid-rows-subgrid"
          >
            <span class="block overflow-hidden rounded-card">
              <Photo
                name={b.image}
                sizes="(min-width: 1200px) 357px, (min-width: 768px) 30vw, 100vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.05] sm:max-md:aspect-[16/9]"
              />
            </span>
            <h3 class="display pt-5 text-2xl lg:text-3xl">{b.name}</h3>
            <p class="pt-2 text-sm leading-relaxed text-muted">{b.blurb}</p>
            <p class="mt-5 flex items-baseline justify-between gap-x-3 border-t border-rule pt-4 md:max-lg:flex-col">
              <span class="text-lg font-bold text-price">{priceLabel(b)}</span>
              <span class="text-xs text-muted">Min. {b.minPax} pax</span>
            </p>
            <p class="flex items-center gap-1.5 pt-3 text-xs font-semibold uppercase tracking-[.12em] text-price">
              View menu
              <Icon
                name="ph:arrow-right"
                class="size-4 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              />
            </p>
          </a>
        </li>
      ))}
    </ul>
    <!-- Other occasions: four equal buttons, each three columns wide from 1024px. -->
    <div class="mt-14 border-t border-rule pt-8">
      <h3 class="display text-2xl md:text-3xl">Planning something else?</h3>
      <p class="mt-2 text-muted">Pick the occasion and ask us for a quotation on WhatsApp.</p>
      <ul class="mt-6 grid gap-3 min-[24rem]:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {occasions.map((o) => (
          <li>
            <a
              href={waLink(o.message)}
              target="_blank"
              rel="noopener"
              class="btn btn-outline btn-block !px-3"
            >
              {o.title}
              <Icon name="ph:arrow-up-right" class="size-4 max-sm:hidden" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
