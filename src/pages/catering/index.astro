---
import { Icon } from 'astro-icon/components';
import DemoBanner from '../../components/DemoBanner.astro';
import MenuImage from '../../components/MenuImage.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { buffets, occasions, priceLabel } from '../../data/buffets';
import { eventMenus, eventPackages, fromPriceCents } from '../../data/eventCatering';
import { url, waLink } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { money } from '../../lib/format';
---

<Layout
  title="Catering"
  description="Choose from five catering menus, then pick Mini or Classic catering for your event."
>
  <DemoBanner />
  <PageHero
    title="Catering"
    intro="Choose a menu, pick Mini or Classic catering, and book your event online."
    image="buffet-setup"
  />

  <section class="container-page py-14" aria-labelledby="menus-title">
    <h2 id="menus-title" class="text-center text-3xl font-bold tracking-tight">
      Our Catering Menus
    </h2>
    <p class="mx-auto mt-3 max-w-[55ch] text-center text-muted">
      Every menu comes as Mini Catering (20 to 50 pax) or Classic Catering (from 50 pax). You choose
      one dish from each category.
    </p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-menu-list>
      {eventMenus.map((m, i) => (
        <li class="card flex flex-col overflow-hidden" data-menu-card={m.slug}>
          <MenuImage
            image={m.image}
            sizes="(min-width: 1200px) 368px, (min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-[4/3] w-full"
          />
          <div class="flex flex-1 flex-col items-center p-5 text-center">
            <p class="text-xs font-semibold tracking-[.14em] text-accent">
              MENU {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-1 text-xl font-bold">{m.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{m.blurb}</p>
            <p class="mt-auto pt-4 text-lg font-bold text-price">
              From {money(fromPriceCents(m))}/pax
            </p>
            <div class="mt-4 w-full rounded-card border border-line p-2">
              <a href={url(`catering/order/${m.slug}/`)} class="btn btn-block" data-order>
                Order
              </a>
              <a
                href={url(`catering/menu/${m.slug}/`)}
                class="mt-1 flex min-h-11 items-center justify-center rounded-control text-base font-medium hover:bg-surface-2"
                data-view-menu
              >
                View Menu
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-surface-2 py-14" aria-labelledby="packages-title">
    <div class="container-page">
      <h2 id="packages-title" class="text-center text-3xl font-bold tracking-tight">
        Mini or Classic?
      </h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {Object.values(eventPackages).map((p) => (
          <li class="card p-6">
            <h3 class="text-xl font-bold">{p.name}</h3>
            <p class="mt-2 leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
              {p.includes.map((x) => (
                <li class="flex items-center gap-2 text-sm">
                  <Icon
                    name="ph:check-circle"
                    class="size-5 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  {x}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-center text-sm text-muted">
        Book at least 3 days ahead. Full payment is taken when you order.
      </p>
    </div>
  </section>

  <section id="buffets" class="container-page scroll-mt-20 py-14" aria-labelledby="buffets-title">
    <h2 id="buffets-title" class="text-center text-3xl font-bold tracking-tight">
      Buffets for Weddings and Large Events
    </h2>
    <p class="mx-auto mt-3 max-w-[55ch] text-center text-muted">
      Full buffets with setup, staff and collection. Tell us your date and guest count on WhatsApp
      and we will send a quotation.
    </p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {buffets.map((b) => (
        <li class="card flex flex-col overflow-hidden" data-buffet-card={b.slug}>
          <Photo
            name={b.image}
            sizes="(min-width: 1200px) 368px, (min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="flex flex-1 flex-col items-center p-5 text-center">
            <h3 class="text-xl font-bold">{b.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{b.blurb}</p>
            <p class="mt-auto pt-4 text-lg font-bold text-price">{priceLabel(b)}</p>
            <p class="text-xs text-muted">Min. {b.minPax} pax</p>
            <a href={url(`catering/buffets/${b.slug}/`)} class="btn btn-block mt-4">
              View Menu and Get a Quote
            </a>
          </div>
        </li>
      ))}
    </ul>
    <div class="mt-10 text-center">
      <h3 class="font-bold">Planning something else?</h3>
      <ul class="mt-3 flex flex-wrap justify-center gap-2">
        {occasions.map((o) => (
          <li>
            <a href={waLink(o.message)} target="_blank" rel="noopener" class="btn btn-outline">
              <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
              {o.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
