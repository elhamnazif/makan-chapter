---
import { Icon } from 'astro-icon/components';
import HomeHero from '../components/HomeHero.astro';
import MoeBadge from '../components/MoeBadge.astro';
import Photo from '../components/Photo.astro';
import Strip from '../components/Strip.astro';
import { url, reviews, menuPdfs } from '../data/site';
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Mains and Bakar-Bakar',
    href: 'order/',
    image: 'bakar-bakar',
    text: 'Grilled and penyet plates, nasi ambeng and nasi lemak, ordered individually.',
    action: 'Order online',
  },
  {
    title: 'Buffet Catering',
    href: 'catering/',
    image: 'buffet-setup',
    text: 'Classic Catering: a full buffet in warmers, with cutlery and drinks, from 50 pax.',
    action: 'See the menus',
  },
  {
    title: 'Mini Buffet',
    href: 'catering/',
    image: 'mini-buffet-tray',
    text: 'Mini Catering: ready-to-enjoy trays for 20 to 50 pax. Five menus to choose from.',
    action: 'See the menus',
  },
  {
    title: 'Kuih Muih',
    href: 'order/#cat-6',
    image: 'kuih-tray',
    text: 'Traditional kuih by the piece, with price lists for larger orders.',
    action: 'Order online',
  },
];

const [featured, ...otherReviews] = [reviews[1], reviews[0], reviews[2]];
---

<Layout>
  <HomeHero />
  <Strip
    label="At a glance"
    items={[
      { icon: 'ph:storefront', text: 'Muslim-owned' },
      { icon: 'ph:truck', text: 'Islandwide delivery' },
      { icon: 'ph:users-three', text: 'Mini buffets from 20 pax' },
    ]}
  />

  <!-- Introduction and services: centred on the page axis, tiles on the 12-column lines -->
  <section class="container-page section" aria-labelledby="services-title">
    <div class="text-center">
      <p class="eyebrow">What we cook</p>
      <h2
        id="services-title"
        class="display mx-auto mt-4 max-w-[20ch] text-4xl text-price md:text-6xl"
      >
        Nasi, Lauk and Kuih, Made for Sharing
      </h2>
      <p class="mx-auto mt-6 max-w-[60ch] leading-relaxed text-muted md:text-lg">
        From a single plate of nasi ambeng to a buffet for hundreds of guests, we cook the dishes
        Singapore gathers around. Order a meal, book a mini buffet, or let us cater your next event.
      </p>
    </div>
    <!-- From 640px each tile is a subgrid of four rows (photo, title, text, action), so the
         titles, texts and actions of neighbouring tiles sit on the same lines whatever their
         length. On phones a tile is a row instead: photo on the text line, words beside it. -->
    <ul class="mt-12 grid gap-y-3 sm:grid-cols-2 sm:gap-x-4 sm:gap-y-0 lg:grid-cols-4 lg:gap-x-8">
      {services.map((s) => (
        <li class="sm:row-span-4 sm:grid sm:grid-cols-[minmax(0,1fr)] sm:grid-rows-subgrid sm:max-lg:[&:nth-child(n+3)]:mt-4">
          <a
            href={url(s.href)}
            class="group grid grid-cols-[7rem_minmax(0,1fr)] overflow-hidden rounded-card bg-band text-band-ink sm:row-span-4 sm:grid-cols-[minmax(0,1fr)] sm:grid-rows-subgrid"
          >
            <div class="relative row-span-3 overflow-hidden sm:row-span-1">
              <Photo
                name={s.image}
                sizes="(min-width: 1200px) 260px, (min-width: 1024px) 22vw, (min-width: 640px) 46vw, 112px"
                class="object-cover transition-transform duration-500 group-hover:scale-[1.05] max-sm:absolute max-sm:inset-0 max-sm:size-full sm:aspect-square sm:w-full"
              />
            </div>
            <h3 class="display px-4 pt-4 text-xl md:px-5 md:pt-5 md:text-2xl">{s.title}</h3>
            <p class="px-4 pt-1.5 text-sm leading-relaxed opacity-90 sm:pt-2 md:px-5">{s.text}</p>
            <p class="flex items-center gap-1.5 self-end whitespace-nowrap px-4 pb-4 pt-3 text-xs font-semibold uppercase tracking-[.12em] sm:pt-4 md:px-5 md:pb-5">
              {s.action}
              <Icon
                name="ph:arrow-right"
                class="size-4 transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              />
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Reviews: one in the display face, the others beneath. Centred. -->
  <section
    class="section border-y border-rule bg-cream text-center"
    aria-labelledby="reviews-title"
  >
    <div class="container-page">
      <h2 id="reviews-title" class="eyebrow">
        What Our Customers Say
      </h2>
      <figure class="mt-6">
        <blockquote class="display mx-auto max-w-[24ch] text-3xl leading-[1.15] text-price md:text-5xl">
          “{featured}”
        </blockquote>
        <figcaption class="mt-6 text-sm font-semibold text-muted">Catering customer</figcaption>
      </figure>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-10 border-t border-rule pt-10 md:grid-cols-2 md:gap-x-8">
        {otherReviews.map((r) => (
          <li>
            <figure>
              <blockquote class="text-lg leading-relaxed">{r}</blockquote>
              <figcaption class="mt-3 text-sm font-semibold text-muted">
                Catering customer
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- About and menus: a 6/6 split. The photo takes the text column's height, so the two
       columns share their top and bottom edges. -->
  <section class="container-page section" aria-labelledby="about-title">
    <div class="cols">
      <div class="relative lg:col-span-6">
        <Photo
          name="dessert-table"
          alt="A Makan Chapter kuih and dessert table at an event"
          sizes="(min-width: 1200px) 552px, (min-width: 1024px) 46vw, 100vw"
          class="aspect-[4/3] w-full rounded-card object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
        />
      </div>
      <div class="lg:col-span-6">
        <p class="eyebrow">About us</p>
        <h2 id="about-title" class="display mt-4 text-4xl text-price md:text-5xl">
          Catering for Every Gathering in Singapore
        </h2>
        <p class="mt-6 leading-relaxed text-muted">
          Makan Chapter is a Muslim-owned kitchen on Serangoon Road. We cater intimate gatherings,
          birthdays, corporate meetings, weddings and festive celebrations with the dishes our
          customers come back for.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <MoeBadge px={80} class="size-20" />
          <p class="text-sm leading-relaxed text-muted">
            <span class="block font-semibold text-ink">Muslim-Owned Enterprise</span>Singapore Malay
            Chamber of Commerce and Industry
          </p>
        </div>
        <p class="mt-6 leading-relaxed text-muted">
          Browse the full menus below, or tell us about your event and we will put together a
          quotation.
        </p>
        <ul class="mt-4 border-t border-rule">
          {menuPdfs.map((m) => (
            <li class="border-b border-rule">
              <a
                href={m.href}
                target="_blank"
                rel="noopener"
                class="group flex min-h-12 items-center justify-between gap-3 font-medium"
              >
                <span class="group-hover:text-price">{m.label}</span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[.12em] text-price">
                  PDF
                  <Icon name="ph:arrow-up-right" class="size-4" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href={url('contact/')} class="btn mt-8">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
