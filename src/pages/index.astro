---
import { Icon } from 'astro-icon/components';
import MoeBadge from '../components/MoeBadge.astro';
import Photo from '../components/Photo.astro';
import { url, reviews, menuPdfs } from '../data/site';
import Layout from '../layouts/Layout.astro';

const slides = [
  { image: 'nasi-ambeng', alt: 'Nasi ambeng with rendang, sambal and sides in a woven basket' },
  { image: 'mini-buffet-tray', alt: 'A Makan Chapter tray of rice and lauk' },
  { image: 'nasi-lemak-plate', alt: 'Nasi lemak with sambal, ikan bilis and egg' },
];

const services = [
  {
    title: 'Mains and Bakar-Bakar',
    href: 'order/',
    image: 'bakar-bakar',
    text: 'Grilled and penyet plates, nasi ambeng and nasi lemak, ordered individually.',
  },
  {
    title: 'Buffet Catering',
    href: 'catering/',
    image: 'buffet-setup',
    text: 'Classic Catering: a full buffet in warmers, with cutlery and drinks, from 50 pax.',
  },
  {
    title: 'Mini Buffet',
    href: 'catering/',
    image: 'mini-buffet-tray',
    text: 'Mini Catering: ready-to-enjoy trays for 20 to 50 pax. Five menus to choose from.',
  },
  {
    title: 'Kuih Muih',
    href: 'order/#cat-6',
    image: 'kuih-tray',
    text: 'Traditional kuih by the piece, with price lists for larger orders.',
  },
];
---

<Layout>
  <!-- Hero: rotating photos, one message, one action -->
  <section
    class="relative isolate flex min-h-[min(calc(100dvh-4rem),760px)] items-center overflow-hidden bg-ink"
    aria-label="Introduction"
    data-hero
  >
    {slides.map((s, i) => (
      <Photo
        name={s.image}
        alt={i === 0 ? s.alt : ''}
        sizes="100vw"
        widths={[640, 960, 1280, 1600]}
        class="hero-slide absolute inset-0 -z-20 size-full object-cover opacity-0 transition-opacity duration-1000 data-[active=true]:opacity-100"
        data-active={i === 0 ? 'true' : 'false'}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
      />
    ))}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/55 to-black/15"></div>
    <div class="container-page py-16">
      <h1 class="max-w-[16ch] text-5xl font-bold leading-[1.05] tracking-tight text-white md:text-6xl">
        We Know, Makan Matters
      </h1>
      <p class="mt-5 max-w-[40ch] text-lg text-white/90">
        Home-style catering for family gatherings, office meals, weddings and festive celebrations.
      </p>
      <a href={url('catering/')} class="btn mt-8 !bg-white !text-zinc-900 hover:!bg-zinc-200">
        Explore Our Catering Menu
      </a>
    </div>
    <div
      class="absolute inset-x-0 bottom-6 flex items-center justify-center gap-2"
      role="group"
      aria-label="Choose photo"
    >
      <button
        type="button"
        class="grid size-8 place-items-center rounded-full text-white hover:bg-white/15"
        aria-label="Pause slideshow"
        data-hero-pause
        hidden
      >
        <Icon name="ph:pause-fill" class="size-4" aria-hidden="true" data-pause-icon />
        <Icon name="ph:play-fill" class="hidden size-4" aria-hidden="true" data-play-icon />
      </button>
      {slides.map((_, i) => (
        <button
          type="button"
          class="grid size-6 place-items-center"
          aria-label={`Show photo ${i + 1}`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-dot={i}
        >
          <span class="block h-1.5 w-6 rounded-full bg-white/50 transition-colors"></span>
        </button>
      ))}
    </div>
  </section>

  <!-- Short introduction -->
  <section class="container-page py-16 text-center md:py-20">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">
      Nasi, Lauk and Kuih, Made for Sharing
    </h2>
    <p class="mx-auto mt-5 max-w-[65ch] text-base leading-relaxed text-muted md:text-lg">
      From a single plate of nasi ambeng to a buffet for hundreds of guests, we cook the dishes
      Singapore gathers around. Order a meal, book a mini buffet, or let us cater your next event.
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-muted">
      <li class="flex items-center gap-2">
        <Icon name="ph:storefront" class="size-5 text-ink" aria-hidden="true" />
        Muslim-owned
      </li>
      <li class="flex items-center gap-2">
        <Icon name="ph:truck" class="size-5 text-ink" aria-hidden="true" />
        Islandwide delivery
      </li>
      <li class="flex items-center gap-2">
        <Icon name="ph:users-three" class="size-5 text-ink" aria-hidden="true" />
        Mini buffets from 20 pax
      </li>
    </ul>
  </section>

  <!-- Service categories -->
  <section class="container-page pb-20" aria-labelledby="services-title">
    <h2 id="services-title" class="sr-only">
      What we offer
    </h2>
    <ul class="grid grid-cols-1 gap-6 min-[480px]:grid-cols-2">
      {services.map((s) => (
        <li>
          <a
            href={url(s.href)}
            class="card group flex h-full flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1"
          >
            <span class="block aspect-[16/10] overflow-hidden bg-surface-2">
              <Photo
                name={s.image}
                sizes="(min-width: 480px) min(50vw, 584px), 100vw"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </span>
            <span class="flex flex-1 flex-col items-center px-5 py-5 text-center">
              <span class="text-lg font-bold">{s.title}</span>
              <span class="mt-2 text-sm leading-relaxed text-muted">{s.text}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- About and menus -->
  <section class="bg-surface-2 py-20" aria-labelledby="about-title">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 id="about-title" class="text-3xl font-bold tracking-tight md:text-4xl">
          Catering for Every Gathering in Singapore
        </h2>
        <p class="mt-5 max-w-[60ch] leading-relaxed text-muted">
          Makan Chapter is a Muslim-owned kitchen on Serangoon Road. We cater intimate gatherings,
          birthdays, corporate meetings, weddings and festive celebrations with the dishes our
          customers come back for.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <MoeBadge px={80} class="size-20" />
          <p class="text-sm leading-relaxed text-muted">
            <span class="block font-semibold text-ink">Muslim-Owned Enterprise</span>Singapore Malay
            Chamber of Commerce and Industry
          </p>
        </div>
        <p class="mt-6 max-w-[60ch] leading-relaxed text-muted">
          Browse the full menus below, or tell us about your event and we will put together a
          quotation.
        </p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-2">
          {menuPdfs.map((m) => (
            <li>
              <a
                href={m.href}
                target="_blank"
                rel="noopener"
                class="flex min-h-11 items-center gap-2 rounded-control border border-line bg-surface px-3 text-sm font-medium hover:bg-bg"
              >
                <Icon name="ph:file-pdf" class="size-5 shrink-0" aria-hidden="true" />
                {m.label}
              </a>
            </li>
          ))}
        </ul>
        <a href={url('contact/')} class="btn mt-8">
          Contact Us
        </a>
      </div>
      <div class="overflow-hidden rounded-card shadow-card">
        <Photo
          name="dessert-table"
          alt="A Makan Chapter kuih and dessert table at an event"
          sizes="(min-width: 1200px) 568px, (min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/3] size-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-20" aria-labelledby="reviews-title">
    <div class="container-page">
      <h2 id="reviews-title" class="text-center text-3xl font-bold tracking-tight md:text-4xl">
        What Our Customers Say
      </h2>
      <ul class="mt-10 -mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
        {reviews.map((r) => (
          <li class="card w-[85%] shrink-0 snap-center p-6 md:w-auto">
            <figure class="flex h-full flex-col">
              <Icon name="ph:quotes-fill" class="size-7 text-muted" aria-hidden="true" />
              <blockquote class="mt-3 flex-1 leading-relaxed">{r}</blockquote>
              <figcaption class="mt-5 text-sm font-semibold text-muted">
                Catering customer
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  import { find, findAll } from '../scripts/dom';

  // Rotating hero photos. Auto-rotation has a pause button (WCAG 2.2.2) and is off entirely
  // for visitors who ask for reduced motion.
  const hero = find('[data-hero]');
  const slides = findAll('.hero-slide', hero);
  const dots = findAll<HTMLButtonElement>('[data-dot]', hero);
  const pause = find<HTMLButtonElement>('[data-hero-pause]', hero);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let index = 0;
  let timer = 0;
  let paused = false;

  const show = (i: number) => {
    index = i;
    slides.forEach((s, n) => (s.dataset.active = String(n === i)));
    dots.forEach((d, n) => {
      d.setAttribute('aria-pressed', String(n === i));
      d.firstElementChild?.classList.toggle('!bg-white', n === i);
    });
  };
  const restart = () => {
    window.clearInterval(timer);
    pause.hidden = reduce.matches;
    if (!reduce.matches && !paused) {
      timer = window.setInterval(() => show((index + 1) % slides.length), 6000);
    }
  };
  show(0);
  restart();
  reduce.addEventListener('change', restart);
  dots.forEach((d, n) =>
    d.addEventListener('click', () => {
      show(n);
      restart();
    }),
  );
  pause.addEventListener('click', () => {
    paused = !paused;
    pause.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
    find('[data-pause-icon]', pause).classList.toggle('hidden', paused);
    find('[data-play-icon]', pause).classList.toggle('hidden', !paused);
    restart();
  });
</script>
