---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import MoeBadge from '../components/MoeBadge.astro';
import { url, reviews, menuPdfs } from '../data/site';

const slides = [
  { image: 'nasi-ambeng', alt: 'Nasi ambeng with rendang, sambal and sides in a woven basket' },
  { image: 'mini-buffet-tray', alt: 'A Makan Chapter tray of rice and lauk' },
  { image: 'nasi-lemak-plate', alt: 'Nasi lemak with sambal, ikan bilis and egg' },
];

const services = [
  { title: 'Mains and Bakar-Bakar', href: 'order/', image: 'bakar-bakar', text: 'Grilled and penyet plates, nasi ambeng and nasi lemak, ordered individually.' },
  { title: 'Buffet Catering', href: 'catering/buffet/', image: 'buffet-setup', text: 'Full buffet with warmers, setup and collection for events from 30 guests.' },
  { title: 'Mini Buffet', href: 'catering/mini-buffet/', image: 'mini-buffet-tray', text: 'Complete 20-pax sets in disposable trays. Five menus, delivered islandwide.' },
  { title: 'Kuih Muih', href: 'order/#cat-6', image: 'kuih-tray', text: 'Traditional kuih by the piece, with price lists for larger orders.' },
];
---
<Layout>
  <!-- Hero: rotating photos, one message, one action -->
  <section class="relative isolate flex min-h-[min(calc(100dvh-4rem),760px)] items-center overflow-hidden bg-ink" aria-label="Introduction" data-hero>
    {slides.map((s, i) => (
      <img
        src={url(`images/${s.image}.webp`)}
        alt={i === 0 ? s.alt : ''}
        class="hero-slide absolute inset-0 -z-20 size-full object-cover opacity-0 transition-opacity duration-1000 data-[active=true]:opacity-100"
        data-active={i === 0 ? 'true' : 'false'}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'auto'}
      />
    ))}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/55 to-black/15"></div>
    <div class="container-page py-16">
      <h1 class="max-w-[16ch] text-5xl font-bold leading-[1.05] tracking-tight text-white md:text-6xl">We Know, Makan Matters</h1>
      <p class="mt-5 max-w-[40ch] text-lg text-white/90">Home-style catering for family gatherings, office meals, weddings and festive celebrations.</p>
      <a href={url('catering/mini-buffet/')} class="btn mt-8 !bg-white !text-zinc-900 hover:!bg-zinc-200">Explore Our Catering Menu</a>
    </div>
    <div class="absolute inset-x-0 bottom-6 flex justify-center gap-2" role="group" aria-label="Choose photo">
      {slides.map((_, i) => (
        <button type="button" class="grid size-6 place-items-center" aria-label={`Show photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-dot={i}>
          <span class="block h-1.5 w-6 rounded-full bg-white/50 transition-colors"></span>
        </button>
      ))}
    </div>
  </section>

  <!-- Short introduction -->
  <section class="container-page py-16 text-center md:py-20">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Nasi, Lauk and Kuih, Made for Sharing</h2>
    <p class="mx-auto mt-5 max-w-[65ch] text-base leading-relaxed text-muted md:text-lg">
      From a single plate of nasi ambeng to a buffet for hundreds of guests, we cook the dishes Singapore gathers around. Order a meal, book a mini buffet, or let us cater your next event.
    </p>
    <ul class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-muted">
      <li class="flex items-center gap-2"><Icon name="ph:storefront" class="size-5 text-ink" aria-hidden="true" />Muslim-owned</li>
      <li class="flex items-center gap-2"><Icon name="ph:truck" class="size-5 text-ink" aria-hidden="true" />Islandwide delivery</li>
      <li class="flex items-center gap-2"><Icon name="ph:users-three" class="size-5 text-ink" aria-hidden="true" />Mini buffets from 20 pax</li>
    </ul>
  </section>

  <!-- Service categories -->
  <section class="container-page pb-20" aria-labelledby="services-title">
    <h2 id="services-title" class="sr-only">What we offer</h2>
    <ul class="grid grid-cols-1 gap-6 min-[480px]:grid-cols-2">
      {services.map((s) => (
        <li>
          <a href={url(s.href)} class="card group flex h-full flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1">
            <span class="block aspect-[16/10] overflow-hidden bg-surface-2">
              <img src={url(`images/${s.image}.webp`)} alt="" loading="lazy" width="640" height="400" class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
            </span>
            <span class="flex flex-1 flex-col items-center px-5 py-5 text-center">
              <span class="text-lg font-bold">{s.title}</span>
              <span class="mt-2 text-sm leading-relaxed text-muted">{s.text}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- About and menus -->
  <section class="bg-surface-2 py-20" aria-labelledby="about-title">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 id="about-title" class="text-3xl font-bold tracking-tight md:text-4xl">Catering for Every Gathering in Singapore</h2>
        <p class="mt-5 max-w-[60ch] leading-relaxed text-muted">
          Makan Chapter is a Muslim-owned kitchen on Serangoon Road. We cater intimate gatherings, birthdays, corporate meetings, weddings and festive celebrations with the dishes our customers come back for.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <MoeBadge class="size-20" />
          <p class="text-sm leading-relaxed text-muted"><span class="block font-semibold text-ink">Muslim-Owned Enterprise</span>Singapore Malay Chamber of Commerce and Industry</p>
        </div>
        <p class="mt-6 max-w-[60ch] leading-relaxed text-muted">
          Browse the full menus below, or tell us about your event and we will put together a quotation.
        </p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-2">
          {menuPdfs.map((m) => (
            <li>
              <a href={m.href} target="_blank" rel="noopener" class="flex min-h-11 items-center gap-2 rounded-control border border-line bg-surface px-3 text-sm font-medium hover:bg-bg">
                <Icon name="ph:file-pdf" class="size-5 shrink-0" aria-hidden="true" />{m.label}
              </a>
            </li>
          ))}
        </ul>
        <a href={url('contact/')} class="btn mt-8">Contact Us</a>
      </div>
      <div class="overflow-hidden rounded-card shadow-card">
        <img src={url('images/dessert-table.webp')} alt="A Makan Chapter kuih and dessert table at an event" loading="lazy" width="1236" height="1400" class="aspect-[4/3] size-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="py-20" aria-labelledby="reviews-title">
    <div class="container-page">
      <h2 id="reviews-title" class="text-center text-3xl font-bold tracking-tight md:text-4xl">What Our Customers Say</h2>
      <ul class="mt-10 -mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
        {reviews.map((r) => (
          <li class="card w-[85%] shrink-0 snap-center p-6 md:w-auto">
            <figure class="flex h-full flex-col">
              <Icon name="ph:quotes-fill" class="size-7 text-muted" aria-hidden="true" />
              <blockquote class="mt-3 flex-1 leading-relaxed">{r}</blockquote>
              <figcaption class="mt-5 text-sm font-semibold text-muted">Catering customer</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLImageElement>('.hero-slide')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let index = 0;
    const show = (i: number) => {
      index = i;
      slides.forEach((s, n) => (s.dataset.active = String(n === i)));
      dots.forEach((d, n) => {
        d.setAttribute('aria-pressed', String(n === i));
        d.firstElementChild?.classList.toggle('!bg-white', n === i);
      });
    };
    show(0);
    dots.forEach((d, n) => d.addEventListener('click', () => { show(n); restart(); }));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    const restart = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => show((index + 1) % slides.length), 6000);
    };
    restart();
  }
</script>
