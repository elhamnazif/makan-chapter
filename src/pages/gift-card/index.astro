---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
const amounts = [25, 50, 100, 150, 200];
---
<Layout title="Gift Card" description="Makan Chapter eGift cards from S$25 to S$200.">
  <PageHero title="eGift Card" intro="Give someone a meal on us. Valid for 12 months after purchase." image="ambeng-basket" compact />

  <div class="container-page py-10">
    <form class="grid gap-6 lg:grid-cols-[1fr_19rem]" novalidate data-gift>
      <div class="space-y-5">
        <fieldset class="card p-5">
          <legend class="float-left w-full font-bold">Amount</legend>
          <div class="clear-both grid grid-cols-3 gap-2 pt-3 sm:grid-cols-5">
            {amounts.map((a, i) => (
              <label class="relative">
                <input type="radio" name="amount" value={a} class="peer sr-only" checked={i === 0} />
                <span class="flex min-h-12 cursor-pointer items-center justify-center rounded-control border border-line font-semibold transition-colors peer-checked:border-accent peer-checked:bg-accent peer-checked:text-accent-ink peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink">S${a}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="card space-y-5 p-5">
          <div>
            <label for="gift-qty" class="field-label">Quantity</label>
            <div class="flex max-w-48 items-center gap-2">
              <button type="button" class="grid size-11 shrink-0 place-items-center rounded-control border border-line hover:bg-surface-2" aria-label="Decrease quantity" data-step="-1"><Icon name="ph:minus-bold" class="size-4" aria-hidden="true" /></button>
              <input id="gift-qty" type="number" min="1" value="1" inputmode="numeric" class="field text-center" />
              <button type="button" class="grid size-11 shrink-0 place-items-center rounded-control border border-line hover:bg-surface-2" aria-label="Increase quantity" data-step="1"><Icon name="ph:plus-bold" class="size-4" aria-hidden="true" /></button>
            </div>
          </div>

          <fieldset>
            <legend class="field-label">Who is the gift card for?</legend>
            <div class="flex flex-wrap gap-x-6">
              <label class="flex min-h-11 cursor-pointer items-center gap-2"><input type="radio" name="for" value="else" checked class="size-4 accent-[var(--mc-accent)]" />For someone else</label>
              <label class="flex min-h-11 cursor-pointer items-center gap-2"><input type="radio" name="for" value="self" class="size-4 accent-[var(--mc-accent)]" />For myself</label>
            </div>
          </fieldset>

          <div class="grid gap-5 sm:grid-cols-2" data-recipient>
            <div>
              <label for="r-email" class="field-label">Recipient email</label>
              <input id="r-email" type="email" class="field" autocomplete="off" placeholder="name@example.com" aria-describedby="r-email-error" />
              <p id="r-email-error" class="field-error" hidden></p>
            </div>
            <div>
              <label for="r-name" class="field-label">Recipient name (optional)</label>
              <input id="r-name" type="text" class="field" autocomplete="off" />
            </div>
          </div>

          <fieldset>
            <legend class="field-label">Delivery</legend>
            <div class="flex flex-wrap gap-x-6">
              <label class="flex min-h-11 cursor-pointer items-center gap-2"><input type="radio" name="when" value="now" checked class="size-4 accent-[var(--mc-accent)]" />Send now</label>
              <label class="flex min-h-11 cursor-pointer items-center gap-2"><input type="radio" name="when" value="later" class="size-4 accent-[var(--mc-accent)]" />Choose a date</label>
            </div>
            <div class="mt-2 max-w-xs" hidden data-when-date>
              <label for="send-date" class="sr-only">Delivery date</label>
              <input id="send-date" type="date" class="field" aria-describedby="send-date-error" />
              <p id="send-date-error" class="field-error" hidden></p>
            </div>
          </fieldset>

          <div>
            <label for="gift-msg" class="field-label">Message (optional)</label>
            <textarea id="gift-msg" rows="3" maxlength="300" class="field"></textarea>
          </div>
        </div>
      </div>

      <aside class="self-start lg:sticky lg:top-20">
        <div class="rounded-control border-2 border-ink bg-surface p-4" aria-live="polite">
          <p class="flex items-center gap-2 font-semibold"><Icon name="ph:gift" class="size-5" aria-hidden="true" />Your gift card</p>
          <p class="mt-2 text-sm text-muted" data-line></p>
          <div class="mt-3 flex items-baseline justify-between border-t border-line pt-3">
            <span class="font-semibold">Total</span>
            <span class="text-2xl font-bold" data-total></span>
          </div>
          <p class="mt-1 text-xs text-muted">Gift card expires 12 months after purchase.</p>
        </div>
        <button type="submit" class="btn btn-block mt-4"><Icon name="ph:shopping-cart-simple" class="size-5" aria-hidden="true" />Add to Cart</button>
      </aside>
    </form>
  </div>
</Layout>

<script>
  import { addItem, money, toast, isoDate, prettyDate } from '../../scripts/cart';

  const form = document.querySelector<HTMLFormElement>('[data-gift]')!;
  const qty = form.querySelector<HTMLInputElement>('#gift-qty')!;
  const email = form.querySelector<HTMLInputElement>('#r-email')!;
  const sendDate = form.querySelector<HTMLInputElement>('#send-date')!;
  sendDate.min = isoDate(new Date());
  const val = (name: string) => form.querySelector<HTMLInputElement>(`[name=${name}]:checked`)!.value;

  function render() {
    const amt = Number(val('amount'));
    const n = Math.max(1, Number(qty.value) || 1);
    form.querySelector('[data-line]')!.textContent = `S$${amt} eGift card x ${n}`;
    form.querySelector('[data-total]')!.textContent = money(amt * 100 * n);
    form.querySelector<HTMLElement>('[data-recipient]')!.hidden = val('for') === 'self';
    form.querySelector<HTMLElement>('[data-when-date]')!.hidden = val('when') !== 'later';
  }
  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => { qty.value = String(Math.max(1, (Number(qty.value) || 1) + Number(b.dataset.step))); render(); }),
  );
  form.addEventListener('input', render);
  form.addEventListener('change', render);

  const setErr = (input: HTMLInputElement, msg: string) => {
    const e = document.getElementById(`${input.id}-error`)!;
    e.textContent = msg; e.hidden = !msg;
    if (msg) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
    return !msg;
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const forElse = val('for') === 'else';
    const later = val('when') === 'later';
    const okEmail = !forElse || setErr(email, !email.value ? 'Enter the recipient email.' : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value) ? '' : 'Enter a valid email address.');
    const okDate = !later || setErr(sendDate, sendDate.value && sendDate.value >= sendDate.min ? '' : 'Choose a delivery date from today onwards.');
    if (!okEmail) { email.focus(); return; }
    if (!okDate) { sendDate.focus(); return; }
    const amt = Number(val('amount'));
    const name = form.querySelector<HTMLInputElement>('#r-name')!.value.trim();
    const msg = form.querySelector<HTMLTextAreaElement>('#gift-msg')!.value.trim();
    const details = [
      forElse ? `For: ${name ? `${name}, ` : ''}${email.value.trim()}` : 'For myself',
      later ? `Send on ${prettyDate(sendDate.value)}` : 'Send now',
      ...(msg ? [`Message: ${msg}`] : []),
    ];
    addItem({ kind: 'gift', id: `gift-${amt}`, name: `S$${amt} eGift Card`, unitCents: amt * 100, unitLabel: 'each', qty: Math.max(1, Number(qty.value) || 1), details });
    toast('Gift card added to cart');
  });
  render();
</script>
