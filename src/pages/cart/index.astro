---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import { url } from '../../data/site';
---
<Layout title="Cart">
  <div class="container-page pb-16 pt-8">
    <h1 class="text-2xl font-bold tracking-tight md:text-3xl">Shopping Cart</h1>

    <div class="mx-auto max-w-md py-14 text-center" hidden data-empty>
      <Icon name="ph:shopping-cart-simple" class="mx-auto size-14 text-muted" aria-hidden="true" />
      <h2 class="mt-4 text-xl font-bold">Your cart is empty</h2>
      <p class="mt-2 text-muted">Add a mini buffet set or a meal to get started.</p>
      <a href={url('order/')} class="btn mt-6"><Icon name="ph:arrow-left" class="size-5" aria-hidden="true" />Continue Shopping</a>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_22rem]" hidden data-filled>
      <div class="space-y-6" data-groups></div>
      <aside class="card self-start p-5 lg:sticky lg:top-20" aria-label="Order summary">
        <h2 class="font-bold">Order Summary</h2>
        <dl class="mt-4 space-y-2 text-sm" data-totals></dl>
        <div class="mt-4 flex items-baseline justify-between border-t border-line pt-4">
          <span class="font-semibold">Total</span>
          <span class="text-2xl font-bold" data-total></span>
        </div>
        <a href={url('delivery/')} class="btn btn-block mt-5">Proceed to Delivery<Icon name="ph:arrow-right-bold" class="size-5" aria-hidden="true" /></a>
        <a href={url('order/')} class="mt-3 flex min-h-11 items-center justify-center text-sm font-medium hover:underline">Continue Shopping</a>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { readCart, writeCart, groups, totals, money, KIND_LABEL, DELIVERY_LABEL, type CartItem } from '../../scripts/cart';

  const wrap = document.querySelector<HTMLElement>('[data-groups]')!;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) {
    const n = document.createElement(tag);
    if (cls) { n.className = cls; }
    if (text != null) { n.textContent = text; }
    return n;
  }

  function update(key: string, fn: (i: CartItem) => CartItem | null) {
    const next = readCart().map((i) => (i.key === key ? fn(i) : i)).filter(Boolean) as Array<CartItem>;
    writeCart(next);
    render();
  }

  function render() {
    const items = readCart();
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = items.length > 0;
    document.querySelector<HTMLElement>('[data-filled]')!.hidden = items.length === 0;
    wrap.replaceChildren();
    const gs = groups(items);
    for (const g of gs) {
      const section = el('section', 'card overflow-hidden');
      const head = el('div', 'flex items-center justify-between border-b border-line bg-surface-2 px-4 py-3');
      head.append(el('h2', 'font-bold', KIND_LABEL[g.kind]));
      if (g.delivery) { head.append(el('span', 'text-sm text-muted', `${DELIVERY_LABEL[g.kind]} ${money(g.delivery)}`)); }
      section.append(head);
      const ul = el('ul', 'divide-y divide-line');
      for (const item of g.list) {
        const li = el('li', 'grid gap-3 p-4 sm:grid-cols-[1fr_auto] sm:items-start');
        const info = el('div');
        info.append(el('p', 'font-semibold', item.name));
        info.append(el('p', 'text-sm text-muted', `${money(item.unitCents)} ${item.unitLabel}`));
        if (item.details.length) {
          const dl = el('ul', 'mt-1.5 space-y-0.5 text-sm text-muted');
          item.details.forEach((d) => dl.append(el('li', '', d)));
          info.append(dl);
        }
        if (item.kind === 'meal') {
          const id = `note-${item.key.replace(/[^a-z0-9]/gi, '')}`;
          const lab = el('label', 'mt-3 block text-sm font-medium', 'Notes for the kitchen (optional)');
          lab.setAttribute('for', id);
          const inp = el('input', 'field mt-1.5 max-w-sm');
          inp.id = id; inp.value = item.note ?? ''; inp.placeholder = 'e.g. less spicy';
          inp.addEventListener('change', () => update(item.key, (i) => ({ ...i, note: inp.value.trim() })));
          info.append(lab, inp);
        }
        const side = el('div', 'flex items-center justify-between gap-4 sm:flex-col sm:items-end');
        const stepper = el('div', 'flex items-center gap-1');
        const minus = el('button', 'grid size-11 place-items-center rounded-control border border-line hover:bg-surface-2', '−');
        minus.type = 'button'; minus.setAttribute('aria-label', `Decrease ${item.name}`);
        const qty = el('span', 'w-10 text-center font-semibold', String(item.qty));
        qty.setAttribute('aria-live', 'polite');
        const plus = el('button', 'grid size-11 place-items-center rounded-control border border-line hover:bg-surface-2', '+');
        plus.type = 'button'; plus.setAttribute('aria-label', `Increase ${item.name}`);
        minus.addEventListener('click', () => update(item.key, (i) => (i.qty > 1 ? { ...i, qty: i.qty - 1 } : i)));
        plus.addEventListener('click', () => update(item.key, (i) => ({ ...i, qty: i.qty + 1 })));
        minus.disabled = item.qty <= 1;
        minus.classList.toggle('opacity-40', item.qty <= 1);
        stepper.append(minus, qty, plus);
        const right = el('div', 'text-right');
        right.append(el('p', 'font-bold', money(item.unitCents * item.qty)));
        const rm = el('button', 'min-h-11 text-sm font-medium text-muted underline-offset-2 hover:text-ink hover:underline', 'Remove');
        rm.type = 'button'; rm.setAttribute('aria-label', `Remove ${item.name}`);
        rm.addEventListener('click', () => update(item.key, () => null));
        right.append(rm);
        side.append(stepper, right);
        li.append(info, side);
        ul.append(li);
      }
      section.append(ul);
      wrap.append(section);
    }
    const t = totals(items);
    const dl = document.querySelector('[data-totals]')!;
    dl.replaceChildren();
    const row = (k: string, v: string) => {
      const d = el('div', 'flex justify-between');
      d.append(el('dt', 'text-muted', k), el('dd', 'font-medium', v));
      dl.append(d);
    };
    row('Subtotal', money(t.subtotal));
    gs.filter((g) => g.delivery).forEach((g) => row(DELIVERY_LABEL[g.kind], money(g.delivery)));
    document.querySelector('[data-total]')!.textContent = money(t.total);
  }
  render();
</script>
