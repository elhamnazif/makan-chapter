---
import { Icon } from 'astro-icon/components';
import InlineScript from '../../components/InlineScript.astro';
import RowTemplate from '../../components/RowTemplate.astro';
import { url } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cart">
  <div class="container-page pb-14 pt-10 md:pb-20">
    <h1 class="display text-4xl text-price md:text-5xl">Shopping Cart</h1>

    <div class="mx-auto max-w-md py-14 text-center" hidden data-empty>
      <Icon name="ph:shopping-cart-simple" class="mx-auto size-14 text-muted" aria-hidden="true" />
      <h2 class="display mt-4 text-3xl">Your cart is empty</h2>
      <p class="mt-2 text-muted">Add a meal or some kuih to get started.</p>
      <a href={url('order/')} class="btn mt-6">
        <Icon name="ph:arrow-left" class="size-5" aria-hidden="true" />
        Continue Shopping
      </a>
    </div>

    <!-- An 8/4 split: ruled rows on the text line, and the summary panel -->
    <div class="cols mt-8" hidden data-filled>
      <section class="lg:col-span-8" aria-labelledby="items-title">
        <h2 id="items-title" class="eyebrow">
          Meals and kuih
        </h2>
        <ul class="mt-3 border-t border-rule" data-items></ul>
      </section>
      <aside class="panel self-start lg:sticky lg:top-20 lg:col-span-4" aria-label="Order summary">
        <h2 class="display text-2xl">Order Summary</h2>
        <dl class="mt-4 space-y-2 text-sm" data-totals></dl>
        <div class="mt-4 flex items-baseline justify-between border-t border-rule pt-4">
          <span class="font-semibold">Total</span>
          <span class="text-2xl font-bold" data-total></span>
        </div>
        <a href={url('delivery/')} class="btn btn-block mt-5">
          Proceed to Delivery
          <Icon name="ph:arrow-right-bold" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={url('order/')}
          class="mt-3 flex min-h-11 items-center justify-center text-sm font-medium hover:underline"
        >
          Continue Shopping
        </a>
      </aside>
    </div>
  </div>

  <template id="tpl-cart-item">
    <li class="border-b border-rule py-5">
      <div class="flex items-baseline justify-between gap-4">
        <p class="text-lg font-semibold" data-slot="name"></p>
        <p class="shrink-0 text-lg font-bold" data-slot="total"></p>
      </div>
      <p class="text-sm text-muted" data-slot="unit"></p>
      <div class="mt-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-1">
          <button
            type="button"
            class="grid size-11 place-items-center rounded-control border border-line hover:bg-surface-2 disabled:opacity-40"
            data-minus
          >
            −
          </button>
          <span class="w-10 text-center font-semibold" aria-live="polite" data-slot="qty"></span>
          <button
            type="button"
            class="grid size-11 place-items-center rounded-control border border-line hover:bg-surface-2"
            data-plus
          >
            +
          </button>
        </div>
        <button
          type="button"
          class="min-h-11 text-sm font-medium text-muted underline-offset-2 hover:text-ink hover:underline"
          data-remove
        >
          Remove
        </button>
      </div>
      <label class="mt-3 block text-sm font-medium" data-note-label>
        Notes for the kitchen (optional)
      </label>
      <input
        name="note"
        class="field mt-1.5 max-w-md"
        maxlength="200"
        placeholder="e.g. less spicy"
        data-note
      />
    </li>
  </template>
  <RowTemplate />
  <InlineScript slot="scripts" entry="cart" />
</Layout>
