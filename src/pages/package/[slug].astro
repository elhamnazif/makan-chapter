---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import { packages, categories, priceLabel } from '../../data/packages';
import { url } from '../../data/site';

export function getStaticPaths() {
  return packages.map((p) => ({ params: { slug: p.slug } }));
}

const pkg = packages.find((p) => p.slug === Astro.params.slug)!;
const cat = categories[pkg.category];
const isOrder = pkg.mode === 'order';
const unitLabel = pkg.paxPerSet ? `set of ${pkg.paxPerSet} pax` : 'pax';
---
<Layout title={pkg.name} description={pkg.blurb}>
  <div class="container-page pb-32 pt-6 lg:pb-16">
    <a href={url(`catering/${pkg.category}/`)} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline">
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />Back to {cat.title}
    </a>
    <h1 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{pkg.name}: {isOrder ? 'Your Order' : 'Request a Quotation'}</h1>

    <form class="mt-6 grid gap-6 lg:grid-cols-[19rem_1fr]" novalidate data-config>
      <!-- Order details column -->
      <aside class="space-y-5 self-start rounded-card border border-line bg-surface-2 p-4 lg:sticky lg:top-20" aria-label="Order details">
        {isOrder && (
          <div class="rounded-control border border-line bg-surface p-3">
            <p class="text-sm font-semibold">Order progress</p>
            <ol class="mt-2 space-y-1.5 text-sm">
              <li class="flex items-center gap-2 font-semibold" aria-current="step"><span class="size-2.5 rounded-full bg-accent"></span>Package selection</li>
              <li class="flex items-center gap-2 text-muted"><span class="size-2.5 rounded-full border border-note-line"></span>Add-ons</li>
            </ol>
          </div>
        )}

        <fieldset class="space-y-3">
          <legend class="mb-2 font-semibold">{isOrder ? 'Delivery date and time' : 'Event date and time'}</legend>
          <div>
            <label for="date" class="field-label">Date</label>
            <input id="date" name="date" type="date" class="field" required aria-describedby="date-error" data-date />
            <p id="date-error" class="field-error" hidden></p>
          </div>
          <div>
            <label for="time" class="field-label">Time</label>
            <input id="time" name="time" type="time" class="field" required aria-describedby="time-error" />
            <p id="time-error" class="field-error" hidden></p>
          </div>
          {pkg.notice && <p class="note flex gap-2"><Icon name="ph:clock" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />{pkg.notice}</p>}
        </fieldset>

        <div>
          <label for="qty" class="mb-2 block font-semibold">{isOrder ? 'Number of sets' : 'Number of guests'}</label>
          <div class="flex items-center gap-2">
            <button type="button" class="grid size-11 shrink-0 place-items-center rounded-control border border-line bg-surface hover:bg-bg" aria-label="Decrease" data-step="-1"><Icon name="ph:minus-bold" class="size-4" aria-hidden="true" /></button>
            <input id="qty" name="qty" type="number" inputmode="numeric" class="field text-center" value={isOrder ? 1 : pkg.minPax} min={isOrder ? 1 : pkg.minPax} step={isOrder ? 1 : 10} aria-describedby="qty-help qty-error" />
            <button type="button" class="grid size-11 shrink-0 place-items-center rounded-control border border-line bg-surface hover:bg-bg" aria-label="Increase" data-step="1"><Icon name="ph:plus-bold" class="size-4" aria-hidden="true" /></button>
          </div>
          <p id="qty-help" class="field-help" data-qty-help>{isOrder ? `Each set serves ${pkg.paxPerSet} pax.` : `Minimum ${pkg.minPax} guests.`}</p>
          <p id="qty-error" class="field-error" hidden></p>
        </div>

        <div>
          <p class="mb-2 font-semibold">{isOrder ? 'Delivery and setup' : 'Included with this package'}</p>
          {isOrder ? (
            <p class="note">Delivered islandwide in disposable trays for S$30. Warmers and buffet setup can be requested on the next step.</p>
          ) : (
            <ul class="note space-y-1.5">
              {pkg.includes?.map((i) => <li class="flex gap-2"><Icon name="ph:check" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />{i}</li>)}
            </ul>
          )}
        </div>

        <div class="hidden rounded-control border-2 border-ink bg-surface p-4 lg:block" aria-live="polite">
          <p class="flex items-center gap-2 font-semibold"><Icon name="ph:receipt" class="size-5" aria-hidden="true" />Your order</p>
          <p class="mt-2 text-sm font-semibold">{pkg.name}</p>
          <p class="text-sm text-muted" data-summary-line></p>
          <div class="mt-3 flex items-baseline justify-between border-t border-line pt-3">
            <span class="font-semibold">{isOrder ? 'Total' : 'Estimate'}</span>
            <span class="text-2xl font-bold" data-summary-total></span>
          </div>
          <p class="mt-1 text-xs text-muted">{isOrder ? 'Not including delivery fee.' : 'Final price confirmed in your quotation.'}</p>
        </div>
      </aside>

      <!-- Menu column -->
      <div>
        <div class="grid gap-4 md:grid-cols-2">
          {pkg.groups.map((g, gi) => (
            <fieldset
              class:list={['rounded-card border border-line bg-surface p-5', g.items.length > 6 && !g.choose && 'md:col-span-2', /^Main( course)?$/.test(g.label) && 'border-t-3 border-t-accent']}
              data-group={gi}
              data-choose={g.choose ?? ''}
              data-label={g.label}
              aria-describedby={g.choose ? `g${gi}-status` : undefined}
            >
              <legend class="float-left w-full text-[1.125rem] text-price">
                <span class="block font-bold">{g.label}{g.choose ? ` (choose ${g.choose})` : ''}</span>
                <span id={`g${gi}-status`} class="mt-0.5 block text-base/[1.6] text-muted" data-status>
                  {g.choose ? `0 of ${g.choose} selected (required)` : 'Included in this package'}
                </span>
              </legend>
              <ul class:list={['clear-both mt-3 grid gap-1 border-t border-line pt-3', g.items.length > 6 && !g.choose && 'sm:grid-cols-2']}>
                {g.items.map((item) => (
                  <li class="not-first:mt-[.65rem]">
                    {g.choose ? (
                      <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-control px-2 hover:bg-surface-2">
                        <input type={g.choose === 1 ? 'radio' : 'checkbox'} name={`g${gi}`} value={item} class="size-4 shrink-0 accent-[var(--mc-accent)]" />
                        <span class="text-base/[1.6]">{item}</span>
                      </label>
                    ) : (
                      <span class="flex min-h-9 items-center gap-3 px-2 text-base/[1.6]">
                        <Icon name="ph:check-circle" class="size-4 shrink-0 text-muted" aria-hidden="true" />{item}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              {g.choose && <p class="field-error" hidden data-group-error></p>}
            </fieldset>
          ))}
        </div>

        <details class="mt-6 rounded-card border border-line bg-surface p-4">
          <summary class="flex min-h-11 cursor-pointer items-center font-semibold">Terms and conditions</summary>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-muted">
            {pkg.terms.map((t) => <li>{t}</li>)}
          </ul>
        </details>

        <button type="submit" class="btn mt-6 hidden lg:inline-flex">
          <Icon name={isOrder ? 'ph:arrow-right-bold' : 'ph:whatsapp-logo'} class="size-5" aria-hidden="true" />{isOrder ? 'Next' : 'Get quotation'}
        </button>
      </div>

      <!-- Mobile action bar -->
      <div class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur lg:hidden">
        <div class="mx-auto flex max-w-xl items-center justify-between gap-4">
          <div>
            <p class="text-xs text-muted">{isOrder ? 'Total before delivery' : 'Estimate'}</p>
            <p class="text-lg font-bold" data-summary-total></p>
          </div>
          <button type="submit" class="btn">
            <Icon name={isOrder ? 'ph:arrow-right-bold' : 'ph:whatsapp-logo'} class="size-5" aria-hidden="true" />{isOrder ? 'Next' : 'Get quotation'}
          </button>
        </div>
      </div>
    </form>
  </div>

  <script type="application/json" id="pkg-data" set:html={JSON.stringify({ ...pkg, unitLabel, priceLabel: priceLabel(pkg) })} />
</Layout>

<script>
  import type { Package } from '../../data/packages';
  import { money, readDraft, writeDraft, isoDate, prettyDate, waUrl, base } from '../../scripts/cart';

  const pkg = JSON.parse(document.getElementById('pkg-data')!.textContent!) as Package & { unitLabel: string };
  const isOrder = pkg.mode === 'order';
  const form = document.querySelector<HTMLFormElement>('[data-config]')!;
  const date = form.querySelector<HTMLInputElement>('#date')!;
  const time = form.querySelector<HTMLInputElement>('#time')!;
  const qty = form.querySelector<HTMLInputElement>('#qty')!;
  const groups = [...form.querySelectorAll<HTMLFieldSetElement>('[data-group]')];
  const min = Number(qty.min);
  const step = Number(qty.step);

  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  date.min = isoDate(tomorrow);

  const choices = () => {
    const out: Record<string, string[]> = {};
    for (const g of groups) {
      if (!g.dataset.choose) continue;
      out[g.dataset.label!] = [...g.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value);
    }
    return out;
  };

  function priceCents(n: number): number | null {
    if (isOrder) return (pkg.setPriceCents ?? 0) * n;
    if (pkg.perPaxCents == null) return null;
    const per = pkg.promo && n >= pkg.promo.fromPax ? pkg.promo.perPaxCents : pkg.perPaxCents;
    return per * n;
  }

  function render() {
    const n = Math.max(min, Number(qty.value) || min);
    const total = priceCents(n);
    const line = isOrder
      ? `${money(pkg.setPriceCents!)} x ${n} set${n > 1 ? 's' : ''} (${n * (pkg.paxPerSet ?? 20)} pax)`
      : total == null ? `${n} guests, price on request` : `${n} guests x ${money(total / n)} per pax`;
    form.querySelector('[data-summary-line]')!.textContent = line;
    form.querySelectorAll('[data-summary-total]').forEach((el) => (el.textContent = total == null ? 'On request' : money(total)));
    if (isOrder) form.querySelector('[data-qty-help]')!.textContent = n > 1 ? `${n} sets serve ${n * (pkg.paxPerSet ?? 20)} pax.` : `Each set serves ${pkg.paxPerSet} pax.`;

    for (const g of groups) {
      const need = Number(g.dataset.choose);
      if (!need) continue;
      const boxes = [...g.querySelectorAll<HTMLInputElement>('input')];
      const picked = boxes.filter((b) => b.checked).length;
      g.querySelector('[data-status]')!.textContent = `${picked} of ${need} selected${picked < need ? ' (required)' : ''}`;
      if (need > 1) boxes.forEach((b) => (b.disabled = !b.checked && picked >= need));
      if (picked === need) hideError(g.querySelector('[data-group-error]'));
    }
  }

  function showError(el: Element | null, msg: string, field?: HTMLElement) {
    if (!el) return;
    el.textContent = msg;
    (el as HTMLElement).hidden = false;
    field?.setAttribute('aria-invalid', 'true');
  }
  function hideError(el: Element | null, field?: HTMLElement) {
    if (!el) return;
    (el as HTMLElement).hidden = true;
    field?.removeAttribute('aria-invalid');
  }

  function validate(): HTMLElement | null {
    let first: HTMLElement | null = null;
    const flag = (el: HTMLElement) => { first ??= el; };
    if (!date.value || date.value < date.min) { showError(document.getElementById('date-error'), date.value ? 'Choose a date from tomorrow onwards.' : 'Choose a date.', date); flag(date); }
    else hideError(document.getElementById('date-error'), date);
    if (!time.value) { showError(document.getElementById('time-error'), 'Choose a time.', time); flag(time); }
    else hideError(document.getElementById('time-error'), time);
    const n = Number(qty.value);
    if (!Number.isInteger(n) || n < min) { showError(document.getElementById('qty-error'), isOrder ? 'Order at least 1 set.' : `Minimum ${min} guests.`, qty); flag(qty); }
    else hideError(document.getElementById('qty-error'), qty);
    for (const g of groups) {
      const need = Number(g.dataset.choose);
      if (!need) continue;
      const picked = g.querySelectorAll('input:checked').length;
      const err = g.querySelector('[data-group-error]');
      if (picked !== need) { showError(err, `Choose ${need} from ${g.dataset.label}.`); flag(g.querySelector('input')!); }
      else hideError(err);
    }
    return first;
  }

  // Restore an in-progress selection when coming back from add-ons.
  const draft = readDraft();
  if (draft && draft.slug === pkg.slug) {
    if (draft.date) date.value = draft.date;
    if (draft.time) time.value = draft.time;
    if (draft.qty) qty.value = String(draft.qty);
    for (const g of groups) {
      const saved = draft.choices?.[g.dataset.label!] ?? [];
      g.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.checked = saved.includes(i.value)));
    }
  }

  form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const next = Math.max(min, (Number(qty.value) || min) + Number(b.dataset.step) * step);
      qty.value = String(next);
      render();
    }),
  );
  form.addEventListener('input', render);
  form.addEventListener('change', render);
  [date, time, qty].forEach((el) => el.addEventListener('input', () => el.getAttribute('aria-invalid') && validate()));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const bad = validate();
    if (bad) { bad.focus(); return; }
    const state = { slug: pkg.slug, date: date.value, time: time.value, qty: Number(qty.value), choices: choices() };
    if (isOrder) {
      writeDraft({ ...state, setup: readDraft()?.slug === pkg.slug ? readDraft()?.setup : false });
      window.location.href = base('add-ons/');
      return;
    }
    const picks = Object.entries(state.choices).map(([k, v]) => `${k}: ${v.join(', ')}`);
    const total = priceCents(state.qty);
    const msg = [
      'Hi Makan Chapter, I would like a quotation.',
      `Package: ${pkg.name}`,
      `Date: ${prettyDate(state.date)}, ${state.time}`,
      `Guests: ${state.qty}`,
      ...picks,
      total != null ? `Estimate shown on site: ${money(total)}` : '',
    ].filter(Boolean).join('\n');
    window.open(waUrl(msg), '_blank', 'noopener');
  });

  render();
</script>
