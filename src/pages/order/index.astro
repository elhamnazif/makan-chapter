---
// Order Online: page hero and a strip of ordering facts, sticky search and category tabs
// with scroll-spy, ruled dish rows (photo, name and price, add button) and a dish dialog.
import { Icon } from 'astro-icon/components';
import { getImage } from 'astro:assets';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Strip from '../../components/Strip.astro';
import catalogue from '../../data/catalogue.json';
import { url, business } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { money } from '../../lib/format';
import { photo } from '../../lib/photos';

// No per-dish photos exist yet. Each section uses the closest real category photo.
const photos = new Map([
  ['cat-1', 'bakar-bakar'],
  ['cat-2', 'nasi-plate'],
  ['cat-3', 'nasi-ambeng'],
  ['cat-4', 'nasi-lemak-plate'],
  ['cat-5', 'nasi-sotong-plate'],
  ['cat-6', 'kuih-tray'],
  ['cat-7', 'lauk'],
]);
const sections = await Promise.all(
  catalogue.categories.map(async (c) => {
    const image = photos.get(c.id);
    if (!image) {
      throw new Error(`No photo for catalogue category ${c.id}`);
    }
    // The dish dialog swaps its photo in from script, so it needs a ready-made URL.
    const dialogImage = await getImage({ src: photo(image), width: 960, format: 'webp' });
    return {
      ...c,
      image,
      dialogImage: dialogImage.src,
      items: catalogue.items.filter((i) => i.categoryId === c.id),
    };
  }),
);
---

<Layout title="Order Online" description="Order meals, nasi ambeng and kuih online for delivery.">
  <PageHero
    title="Order Online"
    intro="Bakar-bakar, penyet, nasi ambeng, nasi lemak and kuih, cooked to order in our kitchen."
    image="nasi-ambeng"
    compact
  />
  <Strip
    label="Ordering details"
    items={[
      { icon: 'ph:truck', text: `${money(catalogue.deliveryFeeCents)} delivery` },
      { icon: 'ph:bowl-food', text: `${catalogue.items.length} dishes` },
      { icon: 'ph:storefront', text: 'Muslim-owned' },
      { icon: 'ph:map-pin', text: business.address[0] },
    ]}
  />

  <!-- Sticky search and category tabs -->
  <div class="sticky top-16 z-20 border-b border-line bg-surface/95 backdrop-blur" data-menu-bar>
    <div class="container-page">
      <div class="flex items-center gap-3 pt-3">
        <search class="flex-1">
          <form class="relative" aria-label="Search the menu" data-search-form>
            <label for="menu-search" class="sr-only">
              Search the menu
            </label>
            <input
              id="menu-search"
              name="q"
              type="search"
              class="field !min-h-10 !bg-surface-2 pr-10"
              placeholder="Search dishes"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              enterkeyhint="search"
              data-search
            />
            <Icon
              name="ph:magnifying-glass"
              class="pointer-events-none absolute right-3 top-1/2 size-5 -translate-y-1/2 text-muted"
              aria-hidden="true"
            />
          </form>
        </search>
        <a
          href={url('cart/')}
          class="btn btn-outline !min-h-10 hidden sm:inline-flex"
          data-cart-button
        >
          <Icon name="ph:shopping-cart-simple" class="size-5" aria-hidden="true" />
          Cart
          <span
            class="grid min-w-5 place-items-center rounded-full bg-accent px-1.5 text-xs font-bold leading-5 text-accent-ink"
            hidden
            data-cart-button-count
          />
          <span class="font-normal text-muted" hidden data-cart-summary />
        </a>
        <!-- Paints the count and subtotal before the first frame (cartPainter, Layout.astro). -->
        <script is:inline>
          globalThis.mcPaintCart?.();
        </script>
      </div>
      <!-- Pulled out by the tabs' side padding, so the first label sits on the text line. -->
      <nav
        aria-label="Menu categories"
        class="-mx-3 -mb-px mt-1 overflow-x-auto [scrollbar-width:none] max-lg:[mask-image:linear-gradient(to_right,#000_calc(100%-3rem),transparent)]"
      >
        <ul class="menu-tabs flex gap-1 whitespace-nowrap max-lg:pr-10" data-tabs>
          {sections.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                class="menu-tab inline-grid min-h-11 place-items-center border-b-2 px-3 text-[15px] transition-colors"
                data-tab={s.id}
                data-label={s.name}
              >
                <span class="col-start-1 row-start-1">{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <!-- Menu sections -->
  <div class="container-page pb-8 pt-10 md:pb-14">
    {sections.map((s, n) => (
      <section
        id={s.id}
        aria-labelledby={`${s.id}-title`}
        class="scroll-mt-44 pb-12 focus:outline-none"
        tabindex="-1"
        data-section={s.id}
      >
        <h2 id={`${s.id}-title`} class="display mb-5 text-3xl text-price md:text-4xl">
          {s.name}
        </h2>
        <ul class="grid lg:grid-cols-2 lg:gap-x-8">
          {s.items.map((i, k) => (
            <li
              class="relative border-t border-rule"
              data-item
              data-search={`${i.name} ${i.description} ${s.name}`.toLowerCase()}
            >
              <button
                type="button"
                class="group flex h-full w-full items-center gap-4 py-4 pr-14 text-left"
                data-open={JSON.stringify({
                  id: i.id,
                  name: i.name,
                  description: i.description,
                  priceCents: i.priceCents,
                  image: s.dialogImage,
                  category: s.name,
                })}
              >
                <span class="block size-22 shrink-0 overflow-hidden rounded-control bg-surface-2 sm:size-26">
                  <Photo
                    name={s.image}
                    sizes="104px"
                    widths={[104, 208, 312]}
                    loading={n === 0 && k < 6 ? 'eager' : 'lazy'}
                    class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-[1.0625rem]/[1.4] font-semibold group-hover:text-price">
                    {i.name}
                  </span>
                  <span class="mt-0.5 block font-bold text-price">{money(i.priceCents)}</span>
                  {i.description && (
                    <span class="mt-1 line-clamp-2 text-sm/[1.5] text-muted">{i.description}</span>
                  )}
                </span>
              </button>
              <button
                type="button"
                class="absolute right-0 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-accent text-accent-ink transition-colors hover:bg-accent-hover"
                aria-label={`Add ${i.name} to cart`}
                data-quick-add={JSON.stringify({
                  id: i.id,
                  name: i.name,
                  priceCents: i.priceCents,
                })}
              >
                <Icon name="ph:plus-bold" class="size-5" aria-hidden="true" />
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <div class="flex flex-col items-center py-14 text-center" hidden data-empty>
      <Icon name="ph:magnifying-glass" class="size-10 text-muted" aria-hidden="true" />
      <p class="mt-3 font-semibold">No dishes match your search.</p>
      <button type="button" class="btn btn-outline mt-5" data-reset>
        Clear search
      </button>
    </div>
  </div>

  <!-- Mobile cart bar -->
  <div
    class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 p-3 backdrop-blur sm:hidden"
    hidden
    data-cart-bar
  >
    <a href={url('cart/')} class="btn btn-block justify-between">
      <span class="flex items-center gap-2">
        <Icon name="ph:shopping-cart-simple" class="size-5" aria-hidden="true" />
        View cart
      </span>
      <span data-cart-bar-summary></span>
    </a>
  </div>
  <script is:inline>
    globalThis.mcPaintCart?.();
  </script>

  <!-- Dish dialog: centred on desktop, full screen on mobile -->
  <dialog
    class="m-0 h-dvh leading-[1.6] max-h-none w-full max-w-none bg-surface p-0 text-ink backdrop:bg-[var(--mc-scrim)] md:m-auto md:h-auto md:max-h-[85dvh] md:w-[min(64rem,92vw)] md:rounded-card"
    aria-labelledby="dish-name"
    closedby="any"
    data-dish
  >
    <form
      method="dialog"
      class="flex h-full flex-col md:grid md:max-h-[85dvh] md:grid-cols-2"
      aria-labelledby="dish-name"
      data-dish-form
    >
      <div class="relative shrink-0">
        <img
          alt=""
          class="aspect-[4/3] w-full object-cover max-md:max-h-[32dvh] md:aspect-auto md:h-full"
          data-dish-img
        />
        <button
          type="submit"
          value="cancel"
          class="absolute left-3 top-3 grid size-11 place-items-center rounded-full bg-white text-zinc-900 shadow-card md:hidden"
          aria-label="Close"
        >
          <Icon name="ph:caret-left-bold" class="size-5" aria-hidden="true" />
        </button>
      </div>
      <div class="flex min-h-0 flex-1 flex-col">
        <div class="relative flex-1 overflow-y-auto px-4 py-5 md:p-6">
          <button
            type="submit"
            value="cancel"
            class="absolute right-6 top-5 hidden size-11 place-items-center rounded-control bg-surface-2 hover:bg-line md:grid"
            aria-label="Close"
          >
            <Icon name="ph:x-bold" class="size-5" aria-hidden="true" />
          </button>
          <p class="text-sm text-muted" data-dish-category></p>
          <h1 id="dish-name" class="display pr-12 text-3xl" data-dish-name></h1>
          <p class="mt-1 text-lg font-semibold" data-dish-price></p>
          <p class="mt-3 leading-relaxed text-muted" data-dish-desc></p>
          <div class="mt-6 border-t border-line pt-5">
            <label for="dish-note" class="field-label">
              Notes for the kitchen (optional)
            </label>
            <textarea
              id="dish-note"
              name="note"
              rows="2"
              maxlength="200"
              class="field"
              placeholder="e.g. less spicy"
            ></textarea>
          </div>
        </div>
        <div class="flex items-center gap-3 border-t border-line p-4 md:px-6">
          <div class="flex items-center rounded-control border border-line">
            <button
              type="button"
              class="grid size-11 place-items-center"
              aria-label="Decrease quantity"
              data-dish-step="-1"
            >
              <Icon name="ph:minus-bold" class="size-4" aria-hidden="true" />
            </button>
            <output class="w-8 text-center font-semibold" aria-live="polite" data-dish-qty>
              1
            </output>
            <button
              type="button"
              class="grid size-11 place-items-center"
              aria-label="Increase quantity"
              data-dish-step="1"
            >
              <Icon name="ph:plus-bold" class="size-4" aria-hidden="true" />
            </button>
          </div>
          <button type="submit" value="add" class="btn flex-1 justify-between">
            <span>Add To Cart</span>
            <span data-dish-total></span>
          </button>
        </div>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  import { money } from '../../lib/format';
  import { addItem } from '../../scripts/cart';
  import type { CartItem } from '../../scripts/cart';
  import { find, findAll, dataValue } from '../../scripts/dom';
  import { toast } from '../../scripts/toast';

  type Dish = {
    id: string;
    name: string;
    description: string;
    priceCents: number;
    image: string;
    category: string;
  };

  // The cart count and subtotal in the bar and on mobile are painted by mcPaintCart
  // (Layout.astro): inline before the first frame, and by Header.astro on every change.

  const add = (d: { id: string; name: string; priceCents: number }, qty: number, note = '') => {
    const item: Omit<CartItem, 'key'> = { id: d.id, name: d.name, unitCents: d.priceCents, qty };
    if (note) {
      item.note = note;
    }
    const saved = addItem(item);
    if (saved) {
      toast(`${qty > 1 ? `${qty} x ` : ''}${d.name} added to cart`);
    }
  };

  findAll<HTMLButtonElement>('[data-quick-add]').forEach((b) =>
    b.addEventListener('click', () => add(JSON.parse(dataValue(b, 'quickAdd')), 1)),
  );

  // Dish dialog. It is modal, so Escape and the back gesture close it; closedby="any" adds
  // a click outside. Scrolling is contained by the dialog:modal rules in global.css.
  const dialog = find<HTMLDialogElement>('[data-dish]');
  const qtyOut = find<HTMLOutputElement>('[data-dish-qty]', dialog);
  const note = find<HTMLTextAreaElement>('#dish-note', dialog);
  let current: Dish | null = null;
  let qty = 1;
  const renderQty = () => {
    qtyOut.textContent = String(qty);
    find('[data-dish-total]', dialog).textContent = current ? money(current.priceCents * qty) : '';
  };
  findAll<HTMLButtonElement>('[data-open]').forEach((b) =>
    b.addEventListener('click', () => {
      current = JSON.parse(dataValue(b, 'open')) as Dish;
      qty = 1;
      note.value = '';
      // The row's small photo is already loaded: show it behind the large one until that arrives,
      // and drop the last dish's photo first so it never shows under this dish's name.
      const photo = find<HTMLImageElement>('[data-dish-img]', dialog);
      const thumb = b.querySelector('img')?.currentSrc;
      photo.removeAttribute('src');
      photo.style.background = thumb ? `url("${thumb}") center / cover` : '';
      photo.src = current.image;
      find('[data-dish-category]', dialog).textContent = current.category;
      find('[data-dish-name]', dialog).textContent = current.name;
      find('[data-dish-price]', dialog).textContent = money(current.priceCents);
      find('[data-dish-desc]', dialog).textContent = current.description;
      renderQty();
      dialog.showModal();
    }),
  );
  findAll<HTMLButtonElement>('[data-dish-step]', dialog).forEach((b) =>
    b.addEventListener('click', () => {
      qty = Math.max(1, Math.min(99, qty + Number(b.dataset.dishStep)));
      renderQty();
    }),
  );
  dialog.addEventListener('close', () => {
    if (dialog.returnValue === 'add' && current) {
      add(current, qty, note.value.trim());
    }
    dialog.returnValue = '';
  });
  // closedby is not yet in every browser: there, close on a press and release outside the
  // dialog box. The pointer position is tested, not the target, which is also the dialog
  // for clicks on its own padding.
  if (!('closedBy' in HTMLDialogElement.prototype)) {
    const outside = (e: PointerEvent) => {
      const r = dialog.getBoundingClientRect();
      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    };
    let pressedOutside = false;
    dialog.addEventListener('pointerdown', (e) => {
      pressedOutside = outside(e);
    });
    dialog.addEventListener('pointerup', (e) => {
      if (pressedOutside && outside(e)) {
        dialog.close();
      }
    });
  }

  // Search
  const search = find<HTMLInputElement>('[data-search]');
  const sections = findAll('[data-section]');
  const tabs = findAll<HTMLAnchorElement>('[data-tab]');
  const empty = find('[data-empty]');
  function apply() {
    const q = search.value.trim().toLowerCase();
    let total = 0;
    for (const s of sections) {
      let n = 0;
      findAll('[data-item]', s).forEach((it) => {
        const ok = !q || dataValue(it, 'search').includes(q);
        it.hidden = !ok;
        if (ok) {
          n++;
        }
      });
      s.hidden = n === 0;
      const tab = tabs.find((t) => t.dataset.tab === s.id)?.parentElement;
      if (tab) {
        tab.hidden = n === 0;
      }
      total += n;
    }
    empty.hidden = total > 0;
  }
  find('[data-search-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    apply();
  });
  search.addEventListener('input', apply);
  find('[data-reset]').addEventListener('click', () => {
    search.value = '';
    apply();
    search.focus();
  });

  // Scroll-spy. Where supported, scroll-target-group marks the tab of the section in view
  // as :target-current; otherwise an observer sets .target-current. Either way aria-current
  // follows, and the tab strip scrolls to keep the current tab in sight.
  const setCurrent = (current: Element | null, withClass: boolean) => {
    for (const t of tabs) {
      const on = t === current;
      if (withClass) {
        t.classList.toggle('target-current', on);
      }
      t.setAttribute('aria-current', String(on));
      if (on) {
        t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    }
  };
  if (CSS.supports('scroll-target-group: auto')) {
    const sync = () => setCurrent(document.querySelector('[data-tabs] a:target-current'), false);
    sync();
    document.addEventListener('scrollend', sync);
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setCurrent(tabs.find((t) => t.dataset.tab === entry.target.id) ?? null, true);
          }
        }
      },
      { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
