---
import { Icon } from 'astro-icon/components';
import MoeBadge from '../../components/MoeBadge.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { url, business } from '../../data/site';
import { stories } from '../../data/stories';
import Layout from '../../layouts/Layout.astro';

const offerings = [
  {
    title: 'Mini and Classic Catering',
    text: 'Five menus in ready-to-enjoy trays from 20 pax, or a full buffet in warmers from 50 pax.',
    href: 'catering/',
    action: 'See the menus',
  },
  {
    title: 'Wedding and Event Buffets',
    text: 'Full buffets with setup and collection for weddings and large events.',
    href: 'catering/#buffets',
    action: 'See the buffets',
  },
  {
    title: 'Meals and Bakar-Bakar',
    text: 'Grilled and penyet plates, nasi ambeng and nasi lemak for one or for the table.',
    href: 'order/',
    action: 'Order online',
  },
  {
    title: 'Kuih Muih',
    text: 'Traditional kuih for tea, festive tables and dessert corners.',
    href: 'order/#cat-6',
    action: 'Order online',
  },
];
const gallery = ['nasi-ambeng', 'bakar-bakar', 'kuih-tray'];
---

<Layout title="Our Story" description="The people and stories behind Makan Chapter.">
  <PageHero title="Our Story" intro={business.tagline + '.'} image="kuih-tray" />

  <!-- Who we are: a short title (two or three lines; never a sentence in display type), then
       a 7/5 split of the paragraph and the recognition. -->
  <section class="container-page section" aria-labelledby="who-title">
    <p class="eyebrow">Who we are</p>
    <h2
      id="who-title"
      class="display mt-4 max-w-[20ch] text-4xl text-price md:text-5xl lg:max-w-none"
    >
      A <span class="whitespace-nowrap">Muslim-Owned</span> Kitchen on Serangoon Road
    </h2>
    <div class="cols mt-8 max-lg:gap-y-6">
      <p class="text-lg leading-relaxed text-muted lg:col-span-7">
        We cook for Singapore’s gatherings, big and small. We cater intimate gatherings, birthdays,
        corporate meetings, weddings and festive celebrations, with nasi ambeng, bakar-bakar, lauk
        and kuih made the way our customers remember them.
      </p>
      <div class="flex items-center gap-4 self-start max-lg:border-t max-lg:border-rule max-lg:pt-6 lg:col-span-5">
        <MoeBadge px={96} class="size-24 shrink-0" eager />
        <p class="text-sm leading-relaxed text-muted">
          <span class="block text-base font-semibold text-ink">Muslim-Owned Enterprise</span>
          Makan Chapter carries the Muslim-Owned Enterprise mark of the Singapore Malay Chamber of
          Commerce and Industry.
        </p>
      </div>
    </div>
    <ul class="mt-14 grid grid-cols-3 gap-3 md:gap-8" aria-hidden="true">
      {gallery.map((name) => (
        <li>
          <Photo
            name={name}
            sizes="(min-width: 1200px) 357px, 31vw"
            loading="eager"
            class="aspect-square w-full rounded-card object-cover md:aspect-[4/3]"
          />
        </li>
      ))}
    </ul>
  </section>

  <!-- Stories, supplied by the owners in src/data/stories.ts. Each is a 6/6 split whose photo
       takes the text column's height. -->
  {stories.length > 0 && (
    <section class="container-page space-y-16 pb-20" aria-label="Stories behind Makan Chapter">
      {stories.map((s, i) => (
        <article class="cols">
          {s.image && (
            <div class:list={['relative lg:col-span-6', i % 2 === 1 && 'lg:order-2']}>
              <Photo
                name={s.image}
                alt={s.imageAlt ?? ''}
                sizes="(min-width: 1200px) 552px, (min-width: 1024px) 46vw, 100vw"
                class="aspect-[4/3] w-full rounded-card object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
              />
            </div>
          )}
          <div class:list={[s.image ? 'lg:col-span-6 lg:min-h-80' : 'lg:col-span-8']}>
            <h2 class="display text-3xl text-price md:text-4xl">{s.title}</h2>
            <div class="mt-5 space-y-4 leading-relaxed text-muted">
              {s.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>
  )}

  <!-- What we cook: four ruled columns on the 12-column lines -->
  <section class="section border-t border-rule bg-cream" aria-labelledby="offer-title">
    <div class="container-page">
      <p class="eyebrow">From our kitchen</p>
      <h2 id="offer-title" class="display mt-4 text-4xl text-price md:text-5xl">
        What We Cook
      </h2>
      <!-- Each item is a subgrid of three rows (title, text, action), so neighbours line up. -->
      <ul class="mt-10 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
        {offerings.map((o) => (
          <li class="row-span-3 grid grid-rows-subgrid border-t border-rule pt-5 max-sm:[&:not(:first-child)]:mt-8 sm:max-lg:[&:nth-child(n+3)]:mt-8">
            <a href={url(o.href)} class="group row-span-3 grid grid-rows-subgrid">
              <span class="display text-2xl">{o.title}</span>
              <span class="pt-3 text-sm leading-relaxed text-muted">{o.text}</span>
              <span class="flex items-center gap-1.5 self-end pt-5 text-xs font-semibold uppercase tracking-[.12em] text-price">
                {o.action}
                <Icon
                  name="ph:arrow-right"
                  class="size-4 transition-transform group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
