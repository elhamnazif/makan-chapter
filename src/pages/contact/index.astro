---
import { Icon } from 'astro-icon/components';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { business } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { phonePattern } from '../../lib/fields';
const services = ['Mini buffet', 'Buffet catering', 'Individual meals', 'Kuih and desserts'];
const events = [
  'Corporate event',
  'Wedding',
  'Birthday party',
  'Festive gathering',
  'Family gathering',
  'Other',
];
const link = 'font-medium underline decoration-rule underline-offset-4 hover:decoration-current';
---

<Layout title="Contact Us">
  <PageHero
    title="Contact Us"
    intro="Here are a few ways to get in touch with us."
    image="buffet-line"
  />

  <!-- The form is a size container: its paired fields sit side by side only when the form
       itself is wide enough for their labels and the date control. -->
  <!-- A 7/5 split. The photo under the contact details takes the height left over beside the
       form, so the two columns share their top and bottom edges. -->
  <div class="container-page section cols">
    <div class="flex flex-col lg:col-span-7">
      <p class="eyebrow">Enquiries</p>
      <h2 class="display mt-4 text-4xl text-price md:text-5xl">
        Tell us about your catering plans
      </h2>
      <p class="mt-6 max-w-[60ch] leading-relaxed text-muted">
        Planning a gathering, office lunch or wedding? Send us the details and we will reply on
        WhatsApp with options and a quotation.
      </p>
      <dl class="mt-8 grid gap-x-8 border-t border-rule sm:grid-cols-2">
        <div class="border-b border-rule py-4">
          <dt class="eyebrow">Phone and WhatsApp</dt>
          <dd class="mt-1.5">
            <a href={business.phoneHref} class={link}>
              {business.phoneDisplay}
            </a>
          </dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="eyebrow">Email</dt>
          <dd class="mt-1.5">
            <a href={`mailto:${business.email}`} class={link}>
              {business.email}
            </a>
          </dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="eyebrow">Address</dt>
          <dd class="mt-1.5">
            {business.address[0]}, {business.address[1]}
            <br />
            <a
              href={business.mapsUrl}
              target="_blank"
              rel="noopener"
              class:list={['inline-flex min-h-11 items-center text-sm', link]}
            >
              Open in Google Maps
            </a>
          </dd>
        </div>
        <div class="border-b border-rule py-4">
          <dt class="eyebrow">Social</dt>
          <dd class="mt-1.5 flex gap-4">
            <a href={business.instagram} target="_blank" rel="noopener" class={link}>
              Instagram
            </a>
            <a href={business.facebook} target="_blank" rel="noopener" class={link}>
              Facebook
            </a>
          </dd>
        </div>
      </dl>
      <div class="relative mt-8 hidden min-h-56 flex-1 lg:block">
        <Photo
          name="lauk"
          sizes="(min-width: 1200px) 650px, 55vw"
          class="absolute inset-0 size-full rounded-card object-cover"
        />
      </div>
    </div>

    <form
      class="panel @container space-y-4 self-start lg:col-span-5"
      novalidate
      aria-labelledby="contact-form-title"
      data-contact
    >
      <h2 id="contact-form-title" class="display text-2xl md:text-3xl">
        Send an Enquiry
      </h2>
      <div>
        <label for="c-name" class="field-label">
          Your name
        </label>
        <input
          id="c-name"
          name="name"
          class="field"
          autocomplete="name"
          required
          aria-describedby="c-name-error"
          data-missing="Enter your name."
        />
        <p id="c-name-error" class="field-error" hidden></p>
      </div>
      <div>
        <label for="c-phone" class="field-label">
          Contact number
        </label>
        <input
          id="c-phone"
          name="phone"
          type="tel"
          class="field"
          autocomplete="tel"
          required
          pattern={phonePattern}
          aria-describedby="c-phone-error"
          data-missing="Enter a contact number."
          data-invalid="Enter a Singapore phone number, e.g. 9123 4567."
        />
        <p id="c-phone-error" class="field-error" hidden></p>
      </div>
      <div>
        <label for="c-event" class="field-label">
          Event type (optional)
        </label>
        <select id="c-event" name="event" class="field">
          <option value="">Select event type</option>
          {events.map((e) => (
            <option>{e}</option>
          ))}
        </select>
      </div>
      <fieldset>
        <legend class="field-label">Services required (optional)</legend>
        <div class="grid gap-x-4 @[20rem]:grid-cols-2">
          {services.map((s) => (
            <label class="flex min-h-10 cursor-pointer items-center gap-2 text-sm">
              <input type="checkbox" name="services" value={s} class="size-4" />
              {s}
            </label>
          ))}
        </div>
      </fieldset>
      <div class="grid gap-4 @[26rem]:grid-cols-2 @[26rem]:gap-3">
        <div>
          <label for="c-date" class="field-label">
            Event date (optional)
          </label>
          <input
            id="c-date"
            name="date"
            type="date"
            class="field"
            aria-describedby="c-date-error"
            data-under="Choose a date from today onwards."
            data-invalid="Enter a valid date."
          />
          <p id="c-date-error" class="field-error" hidden></p>
        </div>
        <div>
          <label for="c-pax" class="field-label">
            Guests (optional)
          </label>
          <input
            id="c-pax"
            name="pax"
            type="number"
            min="1"
            step="1"
            inputmode="numeric"
            class="field"
            aria-describedby="c-pax-error"
            data-invalid="Enter the number of guests as a whole number."
            data-under="Enter at least 1 guest."
          />
          <p id="c-pax-error" class="field-error" hidden></p>
        </div>
      </div>
      <div>
        <label for="c-msg" class="field-label">
          Your message (optional)
        </label>
        <textarea id="c-msg" name="message" rows="4" class="field"></textarea>
      </div>
      <button type="submit" class="btn btn-block">
        <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
        Send Enquiry
      </button>
    </form>
  </div>
</Layout>

<script>
  import { waLink } from '../../data/site';
  import { isoDate, prettyDate } from '../../lib/format';
  import { find, findAll } from '../../scripts/dom';
  import { validator } from '../../scripts/validate';
  import type { Control } from '../../scripts/validate';

  const form = find<HTMLFormElement>('[data-contact]');
  find<HTMLInputElement>('#c-date', form).min = isoDate(new Date());
  const check = validator(form);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const bad = check(findAll<Control>('#c-name, #c-phone, #c-date, #c-pax', form));
    if (bad) {
      bad.focus();
      return;
    }
    const data = new FormData(form);
    const v = (name: string) => String(data.get(name) ?? '').trim();
    const services = data.getAll('services').map(String);
    const lines = [
      'Hi Makan Chapter, I would like to enquire about catering.',
      `Name: ${v('name')}`,
      `Contact: ${v('phone')}`,
      v('event') && `Event: ${v('event')}`,
      services.length > 0 && `Services: ${services.join(', ')}`,
      v('date') && `Date: ${prettyDate(v('date'))}`,
      v('pax') && `Guests: ${v('pax')}`,
      v('message') && `Message: ${v('message')}`,
    ].filter(Boolean);
    window.open(waLink(lines.join('\n')), '_blank', 'noopener');
  });
</script>
