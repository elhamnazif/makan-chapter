---
import { Icon } from 'astro-icon/components';
import InlineScript from '../../components/InlineScript.astro';
import RowTemplate from '../../components/RowTemplate.astro';
import { url } from '../../data/site';
import Layout from '../../layouts/Layout.astro';
import { emailPattern, phonePattern } from '../../lib/fields';

const fields = [
  {
    id: 'name',
    label: 'Full name',
    icon: 'ph:user',
    wide: true,
    attrs: { type: 'text', autocomplete: 'name', placeholder: 'Your full name' } as const,
    missing: 'Enter your full name.',
  },
  {
    id: 'email',
    label: 'Email address',
    icon: 'ph:envelope-simple',
    attrs: {
      type: 'email',
      autocomplete: 'email',
      placeholder: 'you@example.com',
      pattern: emailPattern,
      autocorrect: 'off',
      autocapitalize: 'none',
      spellcheck: 'false',
    } as const,
    missing: 'Enter your email address.',
    invalid: 'Enter a valid email address.',
  },
  {
    id: 'phone',
    label: 'Phone number',
    icon: 'ph:phone',
    attrs: {
      type: 'tel',
      autocomplete: 'tel',
      placeholder: '9123 4567',
      pattern: phonePattern,
    } as const,
    missing: 'Enter your phone number.',
    invalid: 'Enter a Singapore phone number, e.g. 9123 4567.',
  },
];
---

<Layout title="Delivery Details">
  <div class="container-page pb-14 pt-6 md:pb-20">
    <div class="mx-auto max-w-md py-14 text-center" hidden data-empty>
      <Icon name="ph:shopping-cart-simple" class="mx-auto size-14 text-muted" aria-hidden="true" />
      <h1 class="display mt-4 text-3xl">Your cart is empty</h1>
      <p class="mt-2 text-muted">Add something to your cart before entering delivery details.</p>
      <a href={url('order/')} class="btn mt-6">
        Continue Shopping
      </a>
    </div>

    <div hidden data-filled>
      <a
        href={url('cart/')}
        class="inline-flex min-h-11 items-center gap-2 text-sm font-medium hover:underline"
      >
        <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
        Back to Cart
      </a>
      <h1 id="delivery-title" class="display mt-2 text-4xl text-price md:text-5xl">
        Delivery Details
      </h1>
      <p class="mt-3 text-muted">Enter your delivery information to complete your order.</p>

      <!-- An 8/4 split: the form on the text line, and the summary panel -->
      <div class="cols mt-8">
        <form
          class="grid content-start gap-5 sm:grid-cols-2 sm:gap-x-8 lg:col-span-8"
          novalidate
          aria-labelledby="delivery-title"
          data-delivery
        >
          {fields.map((f) => (
            <div class:list={[f.wide && 'sm:col-span-2']}>
              <label for={f.id} class="field-label flex items-center gap-2">
                <Icon name={f.icon} class="size-4" aria-hidden="true" />
                {f.label}
              </label>
              <input
                id={f.id}
                name={f.id}
                class="field"
                required
                aria-describedby={`${f.id}-error`}
                data-missing={f.missing}
                data-invalid={f.invalid}
                {...f.attrs}
              />
              <p id={`${f.id}-error`} class="field-error" hidden></p>
            </div>
          ))}
          <div class="sm:col-span-2">
            <label for="address" class="field-label flex items-center gap-2">
              <Icon name="ph:map-pin" class="size-4" aria-hidden="true" />
              Delivery address
            </label>
            <textarea
              id="address"
              name="address"
              rows="3"
              class="field"
              autocomplete="street-address"
              placeholder="Block, street, unit number and postal code"
              required
              aria-describedby="address-error"
              data-missing="Enter your delivery address."
            ></textarea>
            <p id="address-error" class="field-error" hidden></p>
          </div>
          <div class="sm:col-span-2">
            <label for="notes" class="field-label flex items-center gap-2">
              <Icon name="ph:note-pencil" class="size-4" aria-hidden="true" />
              Special instructions (optional)
            </label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              class="field"
              placeholder="e.g. call on arrival, deliver to the lobby"
            ></textarea>
          </div>
          <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm sm:col-span-2">
            <input type="checkbox" name="marketing" class="size-4" />
            Send me news and promotions from Makan Chapter.
          </label>
          <button type="submit" class="btn sm:col-span-2 sm:justify-self-start">
            <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
            Send Order on WhatsApp
          </button>
          <p class="max-w-[60ch] text-xs text-muted sm:col-span-2">
            Your order opens in WhatsApp as a message. Send it to place your order, and our team
            will confirm availability and payment.
          </p>
        </form>

        <aside
          class="panel self-start lg:sticky lg:top-20 lg:col-span-4"
          aria-label="Order summary"
        >
          <h2 class="display text-2xl">Order Summary</h2>
          <dl class="mt-4 space-y-3 text-sm" data-lines></dl>
          <dl class="mt-4 space-y-2 border-t border-rule pt-4 text-sm" data-totals></dl>
          <div class="mt-4 flex items-baseline justify-between border-t border-rule pt-4">
            <span class="font-semibold">Total</span>
            <span class="text-2xl font-bold" data-total></span>
          </div>
        </aside>
      </div>
    </div>

    <div class="mx-auto max-w-lg py-14 text-center" hidden data-sent tabindex="-1">
      <Icon name="ph:whatsapp-logo" class="mx-auto size-14" aria-hidden="true" />
      <h1 class="display mt-4 text-3xl">Your order is ready in WhatsApp</h1>
      <p class="mt-2 text-muted">
        Press send in WhatsApp to place your order. We will reply to confirm availability, delivery
        and payment.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="#" target="_blank" rel="noopener" class="btn" data-reopen>
          <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
          Open WhatsApp Again
        </a>
        <button type="button" class="btn btn-outline" data-clear>
          Clear Cart
        </button>
      </div>
    </div>
  </div>
  <RowTemplate />
  <InlineScript slot="scripts" entry="delivery" />
</Layout>
